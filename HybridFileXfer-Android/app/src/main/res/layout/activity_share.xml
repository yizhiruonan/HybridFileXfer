<?xml version="1.0" encoding="utf-8"?>
<!--
    分享发送页：整个界面就是一张进度面板，别的一律没有。
    面板由 ShareActivity 在 onCreate 里塞进 ShareProgress.host(this) 造的 ComposeView，
    渲染的就是双窗口弹窗 / 应用外悬浮窗用的那个 ReceiveProgressPanel —— 标题「正在发送文件」、
    电脑名 · 文件名、分段进度条、已发/总量、速率、各通道明细，以及底部的
    「暂停发送 / 继续 / 取消发送 / 关闭」按钮，全都在面板里面。

    所以这里只是一块占位容器：没有图标、没有标题，也不再有自己的按钮
    （底部那颗「取消」已经删掉，免得和面板自带的按钮重复）。

    窗口是 WRAP_CONTENT + 透明背景（见 ShareActivity.onCreate），屏幕上只看得到那张卡片。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/share_panel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
