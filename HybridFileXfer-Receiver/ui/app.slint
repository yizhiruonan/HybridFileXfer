// 多轨快传 · 电脑接收器（Slint / fluent 样式，紧凑版）
import { Button, LineEdit, CheckBox, ComboBox, ScrollView } from "std-widgets.slint";

component Card inherits Rectangle {
    background: #FFFFFF;
    border-radius: 10px;
    border-width: 1px;
    border-color: #E5E5E5;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #10182810;
}

component Divider inherits Rectangle {
    height: 1px;
    background: #EDEDED;
}

component ProgressBar inherits Rectangle {
    in property <float> value: 0;
    height: 6px;
    border-radius: 3px;
    background: #E8E8E8;

    Rectangle {
        width: parent.width * Math.max(0.0, Math.min(1.0, root.value));
        height: parent.height;
        border-radius: 3px;
        background: #005FB8;
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 108px;
    height: 32px;
    border-radius: 4px;
    background: !enabled ? #E6E9ED : (ta.has-hover ? #1A6FC4 : #005FB8);

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: enabled ? #FFFFFF : #9AA4AE;
        font-size: 13.5px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component SecondaryButton inherits Rectangle {
    in property <string> label;
    callback clicked;

    width: 92px;
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #D7D7D7;
    background: ta.has-hover ? #F5F5F5 : #FFFFFF;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: #1A1A1A;
        font-size: 13.5px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea { clicked => { root.clicked(); } }
}

export struct XferSeg {
    // 这一段在整条里的起始位置（0..1）
    start: float,
    // 这一段占整条的比例（0..1）
    span: float,
    // 这一段已完成比例（0..1）
    filled: float,
}

export struct DeviceRow {
    name: string,
    state: string,
    rate: string,
    detail: string,
    expanded: bool,
}

export struct DevicePair {
    left: DeviceRow,
    right: DeviceRow,
    has-right: bool,
}

export component AppWindow inherits Window {
    title: "多轨快传";
    icon: @image-url("logo-accent.png");
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;

    preferred-width: 560px;
    min-width: 520px;
    min-height: 260px;
    background: #F3F3F3;

    in-out property <string> status-title: "未开始接收";
    in-out property <string> status-sub: "点「开始接收」等待手机连接";
    in-out property <string> status-sub-full: "";
    in-out property <int> status-kind: 0;
    in-out property <bool> running: false;

    in-out property <string> dir-text: "";
    in-out property <string> port-text: "5740";
    in-out property <string> ip-text: "192.168.1.5";
    in-out property <int> mode-index: 0;
    in-out property <bool> autostart: false;
    in-out property <bool> tray: true;
    // 右键「发送到」里显示「发送到手机」
    in-out property <bool> sendto: false;
    in-out property <string> message: "";
    // 状态卡下面的一行结果提示（取消接收后那句「已保留进度」/「已删除未完成文件」）
    in-out property <string> notice-text: "";

    // ---- 传输进度 ----
    in-out property <bool> xfer-visible: false;
    // 手机正在从电脑取文件（显示暂停/中断按钮）
    in-out property <bool> send-active: false;
    // 正在接收手机推过来的文件（显示暂停 / 取消按钮）
    in-out property <bool> recv-active: false;
    // 取消接收的确认框：保留进度 / 不保留（删掉未完成文件）/ 继续接收
    in-out property <bool> cancel-ask: false;
    // 这次接收的「取消」已经受理过（收尾 / 重建还在进行）：把按钮收起来，
    // 同一轮接收只允许取消一次 —— 第二次点击如果照样往控制通道插帧，
    // 会和手机端正在做的重建握手抢帧序（手机端报 unexpected control frame）。
    in-out property <bool> recv-cancelling: false;
    in-out property <bool> send-paused: false;
    in-out property <string> file-name: "";
    in-out property <float> file-progress: 0.0;
    in-out property <string> file-text: "";
    in-out property <string> session-text: "";
    // IDM 式分块：一段 = 一条通道负责的连续块区间
    in-out property <[XferSeg]> xfer-segments: [];
    // 多设备列表（点状态卡展开）
    in-out property <[DeviceRow]> devices: [];
    // 两两配对后的行（一行两个小卡片）
    in-out property <[DevicePair]> device-rows: [];
    in-out property <bool> devices-expanded: false;
    // 多台设备时，有文件要推送但没指定目标 → 让用户选一台
    in-out property <bool> ask-target: false;
    // 有设备可展开时才让状态卡可点
    private property <bool> has-devices: root.devices.length > 0;

    // ---- 更新检查：0 检查中 / 1 已是最新 / 2 有新版 / 3 正在下载 / 4 出错 ----
    in-out property <int> update-state: 0;
    in-out property <string> update-text: "";
    in-out property <bool> update-busy: false;

    callback update-clicked();

    callback browse-clicked();
    callback start-clicked();
    callback stop-clicked();
    callback autostart-toggled(bool);
    callback tray-toggled(bool);
    callback sendto-toggled(bool);
    callback device-clicked(int);
    callback device-chosen(int);
    callback toggle-pause-send();
    callback cancel-send();
    // 接收方向的取消：点「取消」先暂停并弹确认框，再按用户的选择收尾。
    // 返回 false = 这次点击被忽略（没有在接收 / 已经在取消中），别弹确认框。
    callback cancel-recv() -> bool;
    callback cancel-keep();
    callback cancel-discard();
    callback cancel-dismiss();
    callback open-dir();

    private property <color> status-color: root.status-kind == 2 ? #0F7B0F : root.status-kind == 3 ? #9D5D00 : #8A8A8A;
    private property <string> status-text: root.status-kind == 2 ? "已连接" : root.status-kind == 3 ? "重试中" : root.status-kind == 1 ? "等待中" : "未启动";

    ScrollView {
    VerticalLayout {
        padding: 12px;
        spacing: 9px;

        // ---------------- 状态（点击展开设备） ----------------
        Card {
            vertical-stretch: 0;
            VerticalLayout {
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 12px;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: #F3F3F3;

                    // 已连接用对勾（与手机端一致），其它状态用手机图标
                    Image {
                        visible: root.status-kind == 2;
                        source: @image-url("status-check.png");
                        colorize: root.status-color;
                        width: 22px;
                        height: 22px;
                        x: 9px;
                        y: 9px;
                    }
                    Image {
                        visible: root.status-kind != 2;
                        source: @image-url("status-phone.png");
                        colorize: root.status-color;
                        width: 22px;
                        height: 22px;
                        x: 9px;
                        y: 9px;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: root.status-title; font-size: 17px; font-weight: 600; color: #1A1A1A; }
                    Text {
                        text: root.devices-expanded ? root.status-sub-full : root.status-sub;
                        font-size: 11px;
                        color: #616161;
                        // 收起时单行省略；展开后换行显示完整通道列表
                        wrap: root.devices-expanded ? word-wrap : no-wrap;
                        overflow: root.devices-expanded ? clip : elide;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.status-text;
                    font-size: 12px;
                    font-weight: 400;
                    color: root.status-color;
                    vertical-alignment: center;
                }

                if root.has-devices : Text {
                    text: root.devices-expanded ? "收起" : "展开";
                    font-size: 11px;
                    color: #8A8A8A;
                    vertical-alignment: center;
                }
            }

            // 取消接收之后的一句结果提示（保留进度 / 已删除未完成文件），
            // 下一次传输开始、或重新点「开始接收」时自动消失
            if root.notice-text != "" : VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-bottom: 10px;
                Text {
                    text: root.notice-text;
                    font-size: 11.5px;
                    color: #0F7B0F;
                    wrap: word-wrap;
                }
            }

            // 展开后的设备：一行两个小卡片（和手机端首页的卡片风格一致）
            if (root.devices-expanded) : VerticalLayout {
                spacing: 6px;
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 10px;
                for p in root.device-rows : HorizontalLayout {
                    spacing: 6px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 46px;
                                border-radius: 10px;
                                background: #F7F7F7;
                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 2px;
                                    alignment: center;
                                    Text {
                                        text: p.left.name;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: #1A1A1A;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: p.left.state + "  ·  " + p.left.rate;
                                        font-size: 10.5px;
                                        color: #616161;
                                        overflow: elide;
                                    }
                                }
                            }
                    if (p.has-right) : Rectangle {
                        horizontal-stretch: 1;
                        height: 46px;
                        border-radius: 10px;
                        background: #F7F7F7;
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 2px;
                            alignment: center;
                            Text {
                                text: p.right.name;
                                font-size: 12px;
                                font-weight: 600;
                                color: #1A1A1A;
                                overflow: elide;
                            }
                            Text {
                                text: p.right.state + "  ·  " + p.right.rate;
                                font-size: 10.5px;
                                color: #616161;
                                overflow: elide;
                            }
                        }
                    }
                    if (!p.has-right) : Rectangle {
                        horizontal-stretch: 1;
                        height: 46px;
                        background: transparent;
                    }
                }
            }
            }
            TouchArea {
                clicked => {
                    if (root.has-devices) {
                        root.devices-expanded = !root.devices-expanded;
                    }
                }
            }
        }

        // ---------------- 选择接收设备 ----------------
        if (root.ask-target) : Card {
            vertical-stretch: 0;
            VerticalLayout {
                width: parent.width;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 4px;

                Text {
                    text: "有文件要推送，选择接收的设备：";
                    font-size: 12px;
                    color: #1A1A1A;
                }
                for d[i] in root.devices : HorizontalLayout {
                    height: 26px;
                    spacing: 8px;
                    Text {
                        text: d.name;
                        font-size: 12px;
                        color: #1A1A1A;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "发送到这台";
                        clicked => { root.device-chosen(i); }
                    }
                }
            }
        }

        // ---------------- 进度（传输时才存在） ----------------
        if root.xfer-visible : Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 6px;

                HorizontalLayout {
                    height: 18px;
                    Text { text: "当前文件"; font-size: 11px; color: #8A8A8A; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.file-text; font-size: 11px; color: #1A1A1A; vertical-alignment: center; }
                }

                Text {
                    text: root.file-name;
                    font-size: 12.5px;
                    color: #1A1A1A;
                    overflow: elide;
                }

                // 分块进度条：一整条方角，按通道切段，每段都从段首往右填，
                // 段与段之间画一条红色竖线 —— 和手机端「正在接收文件」弹窗一致。
                // 全部用绝对定位（bar.width * 比例），不依赖布局，避免填充块被排到中间
                bar := Rectangle {
                    height: 12px;
                    background: #E4E4E4;
                    clip: true;

                    for seg in root.xfer-segments : Rectangle {
                        x: bar.width * seg.start;
                        y: 0px;
                        width: bar.width * seg.span * seg.filled;
                        height: bar.height;
                        background: #005FB8;
                    }
                    for seg[i] in root.xfer-segments : Rectangle {
                        visible: i > 0;
                        x: bar.width * seg.start;
                        y: 0px;
                        width: 1px;
                        height: bar.height;
                        background: #E53935;
                    }
                }

                Text {
                    text: root.session-text;
                    font-size: 11px;
                    color: #616161;
                }

                if root.send-active || root.recv-active : HorizontalLayout {
                    height: 30px;
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    SecondaryButton {
                        label: root.send-paused ? "继续" : "暂停";
                        clicked => { root.toggle-pause-send(); }
                    }
                    if root.send-active : SecondaryButton {
                        label: "中断发送";
                        clicked => { root.cancel-send(); }
                    }
                    // 接收方向原来只有「暂停 / 继续」，用户没法真的取消这次传输。
                    // 点「取消」先暂停（手机端跟着停发），再问一句已收到的部分怎么处理，
                    // 语义和手机端的取消确认框一致（保留进度 / 不保留）。
                    // 已经在取消中（收尾 / 重建）就把按钮收起来：取消是幂等的，
                    // 第二轮点击既没有意义，又可能和重建握手抢帧序。
                    if root.recv-active && !root.recv-cancelling : SecondaryButton {
                        label: "取消";
                        // cancel-recv 返回 false（被忽略）时不要弹确认框
                        clicked => {
                            if (root.cancel-recv()) {
                                root.cancel-ask = true;
                            }
                        }
                    }
                }
            }
        }

        // ---------------- 设置 ----------------
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 6px;

                // 接收文件夹：标签在上，输入框自适应
                Text { text: "接收文件夹"; font-size: 11px; color: #8A8A8A; }
                HorizontalLayout {
                    height: 30px;
                    vertical-stretch: 0;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.dir-text;
                        placeholder-text: "D:\\接收文件夹";
                    }
                    Button { text: "浏览…"; clicked => { root.browse-clicked(); } }
                    Button { text: "打开"; clicked => { root.open-dir(); } }
                }

                Divider { }

                // 端口 / 连接方式
                HorizontalLayout {
                    spacing: 14px;
                    vertical-stretch: 0;

                    VerticalLayout {
                        width: 110px;
                        spacing: 3px;
                        Text { text: "端口"; font-size: 11px; color: #8A8A8A; }
                        LineEdit { text <=> root.port-text; }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        Text { text: "连接方式"; font-size: 11px; color: #8A8A8A; }
                        ComboBox {
                            model: ["自动发现（USB / 局域网）", "指定 IP"];
                            current-index <=> root.mode-index;
                        }
                    }
                }

                // 指定 IP（仅在指定 IP 模式显示）
                LineEdit {
                    visible: root.mode-index == 1;
                    text <=> root.ip-text;
                    placeholder-text: "192.168.1.5";
                }

                Rectangle { height: 2px; }

                Rectangle { height: 2px; }
                CheckBox {
                    text: "开机自动启动（登录后最小化运行）";
                    checked <=> root.autostart;
                    toggled => { root.autostart-toggled(root.autostart); }
                }

                CheckBox {
                    text: "关闭窗口后最小化到托盘（后台继续等待连接）";
                    checked <=> root.tray;
                    toggled => { root.tray-toggled(root.tray); }
                }

                CheckBox {
                    text: "在右键「发送到」菜单里显示「发送到手机」";
                    checked <=> root.sendto;
                    toggled => { root.sendto-toggled(root.sendto); }
                }

                Text {
                    text: root.message;
                    visible: root.message != "";
                    font-size: 11px;
                    color: #9D5D00;
                }

                // 有新版才出现的一行
                if root.update-state == 2 : HorizontalLayout {
                    height: 30px;
                    vertical-stretch: 0;
                    spacing: 8px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #005FB8;
                    }
                    Text {
                        text: root.update-text;
                        font-size: 11.5px;
                        color: #005FB8;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "去下载";
                        clicked => { root.update-clicked(); }
                    }
                }

                if root.update-state == 3 : Text {
                    text: root.update-text;
                    font-size: 11.5px;
                    color: #005FB8;
                }

                if root.update-state == 4 : Text {
                    text: root.update-text;
                    font-size: 11px;
                    color: #9D5D00;
                }

                if root.update-state == 5 : Text {
                    text: root.update-text;
                    font-size: 10.5px;
                    color: #0F7B0F;
                    overflow: elide;
                }

                Divider { }

                HorizontalLayout {
                    height: 32px;
                    vertical-stretch: 0;
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    SecondaryButton {
                        label: "停止接收";
                        visible: root.running;
                        clicked => { root.stop-clicked(); }
                    }
                    PrimaryButton {
                        label: "开始接收";
                        enabled: !root.running;
                        clicked => { root.start-clicked(); }
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
    }

    // ---------------- 取消接收：确认框 ----------------
    // 盖住整窗的半透明遮罩 + 居中的卡片。三个选择：
    //   「继续接收」= 只是关掉这个框（顺手把"为了不白传"而加的暂停放掉）；
    //   「不保留，删掉」= 删掉没传完的文件和 .hfxpart 续传记录，下次从头传；
    //   「保留进度」= 留着半截文件和续传记录，下次同一个文件接着传。
    if root.cancel-ask : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000059;

        // 吃掉遮罩上的点击，别透到下面的按钮（免得误触「停止接收」）
        TouchArea { }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Card {
                    width: 424px;
                    height: 188px;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;

                        Text {
                            text: "取消接收？";
                            font-size: 15px;
                            font-weight: 600;
                            color: #1A1A1A;
                        }
                        Text {
                            text: "已经收到的部分怎么处理？（手机端也会停止这次发送）";
                            font-size: 11.5px;
                            color: #616161;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "保留进度：留半截文件和续传记录，下次接着传；不保留：删掉。";
                            font-size: 11.5px;
                            color: #8A8A8A;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 8px;
                            Rectangle { horizontal-stretch: 1; }
                            SecondaryButton {
                                width: 92px;
                                label: "继续接收";
                                clicked => { root.cancel-ask = false; root.cancel-dismiss(); }
                            }
                            SecondaryButton {
                                width: 128px;
                                label: "不保留，删掉";
                                clicked => { root.cancel-ask = false; root.cancel-discard(); }
                            }
                            PrimaryButton {
                                width: 104px;
                                label: "保留进度";
                                clicked => { root.cancel-ask = false; root.cancel-keep(); }
                            }
                        }
                    }
                }
            }
        }
    }
}