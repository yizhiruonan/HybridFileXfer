// 多轨快传 · 电脑接收器（Slint / fluent 样式，紧凑版）
import { Button, LineEdit, CheckBox, ComboBox, ScrollView } from "std-widgets.slint";

component Card inherits Rectangle {
    background: #FFFFFF;
    border-radius: 10px;
    border-width: 1px;
    border-color: #E5E5E5;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #10182810;
}

component Divider inherits Rectangle {
    height: 1px;
    background: #EDEDED;
}

component ProgressBar inherits Rectangle {
    in property <float> value: 0;
    height: 6px;
    border-radius: 3px;
    background: #E8E8E8;

    Rectangle {
        width: parent.width * Math.max(0.0, Math.min(1.0, root.value));
        height: parent.height;
        border-radius: 3px;
        background: #005FB8;
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 108px;
    height: 32px;
    border-radius: 4px;
    background: !enabled ? #E6E9ED : (ta.has-hover ? #1A6FC4 : #005FB8);

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: enabled ? #FFFFFF : #9AA4AE;
        font-size: 13px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component SecondaryButton inherits Rectangle {
    in property <string> label;
    callback clicked;

    width: 92px;
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #D7D7D7;
    background: ta.has-hover ? #F5F5F5 : #FFFFFF;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: #1A1A1A;
        font-size: 13px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea { clicked => { root.clicked(); } }
}

// 取消确认框（CancelAskWindow）专用的按钮：照 Windows 11 对话框那颗的样子画 ——
// 浅灰底 + 1px 细边框 + 深色字，**不上蓝底**。
//
// 为什么主按钮（默认那颗）也不上蓝：①这一轮用户的要求就是「降饱和」；
// ②这颗按钮代表的是「保留进度」，不是「马上要执行的操作」，蓝底会把眼睛从
//   「取消接收？」这个问句上拽走；③经典 Win32 MessageBox 的默认按钮本来就是
//   灰底 + 粗字 + 更实的描边，Win11 只是把描边换成细的 #D0D0D0。
//   要恢复成 Win11 的强调色主按钮，把下面 primary 那两行的底色换成 #0067C0、
//   文字换成 #FFFFFF 即可（一行的事，不动布局）。
//
// 颜色出处：
//   * 次按钮底色 #FAFAFA、边框 #D0D0D0 = Windows 11 ContentDialog 的实测值（用户给的）；
//   * hover #F5F5F5 是从 #FAFAFA 往下压一档，和按钮自己的常态拉开明度差
//     （原生按钮的 hover 就是这么来的，压的是明度，不动色相）；
//   * 默认那颗 #F0F0F0 / hover #E8E8E8：比次按钮再深一档，配合加粗字，一眼看出它是默认项。
component AskButton inherits Rectangle {
    in property <string> label;
    // true = 默认按钮（灰底深一档 + 加粗），false = 普通按钮
    in property <bool> primary: false;
    callback clicked;

    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #D0D0D0;
    background: root.primary
        ? (ta.has-hover ? #E8E8E8 : #F0F0F0)
        : (ta.has-hover ? #F5F5F5 : #FAFAFA);

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        // #000000 = 参考图 docs/explorer-copy-dialog.png 文字的最暗像素（(60,141)、(46,50)）
        color: #000000;
        font-size: 13px;
        font-weight: root.primary ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea { clicked => { root.clicked(); } }
}

export struct DeviceRow {
    name: string,
    state: string,
    rate: string,
    detail: string,
    expanded: bool,
}

export struct DevicePair {
    left: DeviceRow,
    right: DeviceRow,
    has-right: bool,
}

// 「详细信息」里的每一行：一段 = 一条通道负责的连续块区间
// （数据源是 PROGRESS.segments()，电脑端目前没有"每通道速率"，所以这里只有
//  占整条多少 + 这段自己收了多少 —— 不编数据）
export struct XferRow {
    name: string,
    // 这一段占整条的比例，如 "24%"
    span-text: string,
    // 这一段自己：已收 / 该段总量
    amount: string,
    // 这一段自己的速率（「—」= 这一秒没动静）
    rate: string,
    // 这一段完成百分比 0..100
    percent: int,
}

// 进度条上的「一截」：IDM 那种一条杠被切成几截、各自往前跑的画法。
// 每截的位置和宽度都是相对整条的比例（0..1），填了多少也是比例。
export struct XferSeg {
    // 这一截从整条的哪个位置开始
    x: float,
    // 占整条多少
    span: float,
    // 这一截自己填了多少（0..1）
    filled: float,
}

// （取消确认框的旧遮罩组件已删除：现在是独立窗口 CancelAskWindow，见下面。）
// 取消接收的确认框：**独立窗口**（用户要求，不要挤在传输窗口里）。
//
// 以前它是传输窗口上的一个遮罩层，得靠「给布局加 65px 占位」把窗口物理撑高才露得全
// （Slint 的窗口高度取根布局需求，set_size 会被夹回去，见 TRANSFER-WINDOW.md §6.2）。
// 独立窗口不用跟布局较劲：自己的尺寸自己说了算，传输窗口该多高还是多高；
// 也不会挡住传输窗口上的暂停/取消按钮 —— 用户可以先处理完这个框再说。
export component CancelAskWindow inherits Window {
    title: "取消接收";
    width: 424px;
    height: 172px;
    // 标题栏 ✕ 当成「继续接收」（不改主意）：这个回调挂不了在 Window 上，
    // 由 gui_slint.rs 用 on_close_requested 接（和传输窗口的 ✕ 一个路子）。

    callback keep();
    callback discard();
    callback dismiss();

    Rectangle {
        width: 100%;
        height: 100%;
        // 底色 #FFFFFF = 参考图 docs/explorer-copy-dialog.png 客户区 (5,60) 取的，
        // 原生对话框就是纯白，不用再压（原来的 #FFFFFF 本来就对，保留并注明出处）
        background: #FFFFFF;
        border-width: 1px;
        // #D0D0D0 = Windows 11 控件的细描边（用户给的 ContentDialog 值），原来是 #C8C8C8；
        // 压淡一档是为了和「浅灰底按钮」同一套灰度，别让边框抢眼
        border-color: #D0D0D0;

        VerticalLayout {
            padding: 16px;
            spacing: 8px;

            Text {
                text: "取消接收？";
                font-size: 15px;
                font-weight: 600;
                // #000000 = 参考图正文文字的最暗像素（(60,141)、(46,50)），原来是 #1A1A1A
                color: #000000;
            }
            Text {
                text: "已经收到的部分怎么处理？（选好之后就停，这几秒传输先照常跑）";
                font-size: 12px;
                color: #616161;
                wrap: word-wrap;
            }
            Text {
                text: "保留进度：留半截文件和续传记录，下次接着传；不保留：删掉。";
                font-size: 12px;
                color: #8A8A8A;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                height: 32px;
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                // 三颗都用 AskButton：浅灰底 + 细边框 + 深色字（见文件上半部分的组件注释）。
                // 以前是 SecondaryButton(#FFFFFF) + PrimaryButton(#005FB8 蓝底白字)，
                // 那颗蓝底就是用户说的「太鲜艳」；现在默认项只用「深一档的灰 + 加粗」表示。
                AskButton {
                    width: 92px;
                    label: "继续接收";
                    clicked => { root.dismiss(); }
                }
                AskButton {
                    width: 128px;
                    label: "不保留，删掉";
                    clicked => { root.discard(); }
                }
                AskButton {
                    width: 104px;
                    label: "保留进度";
                    primary: true;
                    clicked => { root.keep(); }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "多轨快传";
    icon: @image-url("logo-accent.png");
    default-font-family: "Segoe UI, Microsoft YaHei UI";
    default-font-size: 13px;

    preferred-width: 560px;
    min-width: 520px;
    min-height: 260px;
    background: #F3F3F3;

    in-out property <string> status-title: "未开始接收";
    in-out property <string> status-sub: "点「开始接收」等待手机连接";
    in-out property <string> status-sub-full: "";
    in-out property <int> status-kind: 0;
    in-out property <bool> running: false;

    in-out property <string> dir-text: "";
    in-out property <string> port-text: "5740";
    in-out property <string> ip-text: "192.168.1.5";
    in-out property <int> mode-index: 0;
    in-out property <bool> autostart: false;
    in-out property <bool> tray: true;
    // 右键「发送到」里显示「发送到手机」
    in-out property <bool> sendto: false;
    in-out property <string> message: "";
    // 状态卡下面的一行结果提示（取消接收后那句「已保留进度」/「已删除未完成文件」）
    in-out property <string> notice-text: "";

    // ---- 传输进度 ----
    in-out property <bool> xfer-visible: false;
    // 手机正在从电脑取文件（显示暂停/中断按钮）
    in-out property <bool> send-active: false;
    // 正在接收手机推过来的文件（显示暂停 / 取消按钮）
    in-out property <bool> recv-active: false;
    // 取消接收的确认框：保留进度 / 不保留（删掉未完成文件）/ 继续接收
    in-out property <bool> cancel-ask: false;
    // 这次接收的「取消」已经受理过（收尾 / 重建还在进行）：把按钮收起来，
    // 同一轮接收只允许取消一次 —— 第二次点击如果照样往控制通道插帧，
    // 会和手机端正在做的重建握手抢帧序（手机端报 unexpected control frame）。
    in-out property <bool> recv-cancelling: false;
    in-out property <bool> send-paused: false;
    in-out property <string> file-name: "";
    in-out property <float> file-progress: 0.0;
    in-out property <string> file-text: "";
    in-out property <string> session-text: "";
    // 多设备列表（点状态卡展开）
    in-out property <[DeviceRow]> devices: [];
    // 两两配对后的行（一行两个小卡片）
    in-out property <[DevicePair]> device-rows: [];
    in-out property <bool> devices-expanded: false;
    // 多台设备时，有文件要推送但没指定目标 → 让用户选一台
    in-out property <bool> ask-target: false;
    // 有设备可展开时才让状态卡可点
    private property <bool> has-devices: root.devices.length > 0;

    // ---- 更新检查：0 检查中 / 1 已是最新 / 2 有新版 / 3 正在下载 / 4 出错 ----
    in-out property <int> update-state: 0;
    in-out property <string> update-text: "";
    in-out property <bool> update-busy: false;

    callback update-clicked();

    callback browse-clicked();
    callback start-clicked();
    callback stop-clicked();
    callback autostart-toggled(bool);
    callback tray-toggled(bool);
    callback sendto-toggled(bool);
    callback device-clicked(int);
    callback device-chosen(int);
    callback toggle-pause-send();
    callback cancel-send();
    // 接收方向的取消：点「取消」先暂停并弹确认框，再按用户的选择收尾。
    // 返回 false = 这次点击被忽略（没有在接收 / 已经在取消中），别弹确认框。
    callback cancel-recv() -> bool;
    callback cancel-keep();
    callback cancel-discard();
    callback cancel-dismiss();
    callback open-dir();

    private property <color> status-color: root.status-kind == 2 ? #0F7B0F : root.status-kind == 3 ? #9D5D00 : #8A8A8A;
    private property <string> status-text: root.status-kind == 2 ? "已连接" : root.status-kind == 3 ? "重试中" : root.status-kind == 1 ? "等待中" : "未启动";

    ScrollView {
    VerticalLayout {
        padding: 12px;
        spacing: 9px;

        // ---------------- 状态（点击展开设备） ----------------
        Card {
            vertical-stretch: 0;
            VerticalLayout {
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 12px;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: #F3F3F3;

                    // 已连接用对勾（与手机端一致），其它状态用手机图标
                    Image {
                        visible: root.status-kind == 2;
                        source: @image-url("status-check.png");
                        colorize: root.status-color;
                        width: 22px;
                        height: 22px;
                        x: 9px;
                        y: 9px;
                    }
                    Image {
                        visible: root.status-kind != 2;
                        source: @image-url("status-phone.png");
                        colorize: root.status-color;
                        width: 22px;
                        height: 22px;
                        x: 9px;
                        y: 9px;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: root.status-title; font-size: 17px; font-weight: 600; color: #1A1A1A; }
                    Text {
                        text: root.devices-expanded ? root.status-sub-full : root.status-sub;
                        font-size: 11px;
                        color: #616161;
                        // 收起时单行省略；展开后换行显示完整通道列表
                        wrap: root.devices-expanded ? word-wrap : no-wrap;
                        overflow: root.devices-expanded ? clip : elide;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.status-text;
                    font-size: 12px;
                    font-weight: 400;
                    color: root.status-color;
                    vertical-alignment: center;
                }

                if root.has-devices : Text {
                    text: root.devices-expanded ? "收起" : "展开";
                    font-size: 11px;
                    color: #8A8A8A;
                    vertical-alignment: center;
                }
            }

            // 取消接收之后的一句结果提示（保留进度 / 已删除未完成文件），
            // 下一次传输开始、或重新点「开始接收」时自动消失
            if root.notice-text != "" : VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-bottom: 10px;
                Text {
                    text: root.notice-text;
                    font-size: 12px;
                    color: #0F7B0F;
                    wrap: word-wrap;
                }
            }

            // 展开后的设备：一行两个小卡片（和手机端首页的卡片风格一致）
            if (root.devices-expanded) : VerticalLayout {
                spacing: 6px;
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 10px;
                for p in root.device-rows : HorizontalLayout {
                    spacing: 6px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 46px;
                                border-radius: 10px;
                                background: #F7F7F7;
                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 2px;
                                    alignment: center;
                                    Text {
                                        text: p.left.name;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: #1A1A1A;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: p.left.state + "  ·  " + p.left.rate;
                                        font-size: 11px;
                                        color: #616161;
                                        overflow: elide;
                                    }
                                }
                            }
                    if (p.has-right) : Rectangle {
                        horizontal-stretch: 1;
                        height: 46px;
                        border-radius: 10px;
                        background: #F7F7F7;
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 2px;
                            alignment: center;
                            Text {
                                text: p.right.name;
                                font-size: 12px;
                                font-weight: 600;
                                color: #1A1A1A;
                                overflow: elide;
                            }
                            Text {
                                text: p.right.state + "  ·  " + p.right.rate;
                                font-size: 11px;
                                color: #616161;
                                overflow: elide;
                            }
                        }
                    }
                    if (!p.has-right) : Rectangle {
                        horizontal-stretch: 1;
                        height: 46px;
                        background: transparent;
                    }
                }
            }
            }
            TouchArea {
                clicked => {
                    if (root.has-devices) {
                        root.devices-expanded = !root.devices-expanded;
                    }
                }
            }
        }

        // ---------------- 选择接收设备 ----------------
        if (root.ask-target) : Card {
            vertical-stretch: 0;
            VerticalLayout {
                width: parent.width;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 4px;

                Text {
                    text: "有文件要推送，选择接收的设备：";
                    font-size: 12px;
                    color: #1A1A1A;
                }
                for d[i] in root.devices : HorizontalLayout {
                    height: 26px;
                    spacing: 8px;
                    Text {
                        text: d.name;
                        font-size: 12px;
                        color: #1A1A1A;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "发送到这台";
                        clicked => { root.device-chosen(i); }
                    }
                }
            }
        }

        // 进度卡已经从主界面删掉（用户：「接收器里的进度条 ui 直接去掉」）。
        // 传输进度只在独立的 TransferWindow 里看 —— 那里才是主角，主窗口只留设备 / 设置 / 提示。
        // 下面的 file-text / session-text / xfer-visible 这些属性和回调还留着：
        // gui_slint.rs 还在往里喂（一张卡换一种画法时不用改协议层），只是没人画了。

        // ---------------- 设置 ----------------
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 6px;

                // 接收文件夹：标签在上，输入框自适应
                Text { text: "接收文件夹"; font-size: 11px; color: #8A8A8A; }
                HorizontalLayout {
                    height: 30px;
                    vertical-stretch: 0;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.dir-text;
                        placeholder-text: "D:\\接收文件夹";
                    }
                    Button { text: "浏览…"; clicked => { root.browse-clicked(); } }
                    Button { text: "打开"; clicked => { root.open-dir(); } }
                }

                Divider { }

                // 端口 / 连接方式
                HorizontalLayout {
                    spacing: 14px;
                    vertical-stretch: 0;

                    VerticalLayout {
                        width: 110px;
                        spacing: 3px;
                        Text { text: "端口"; font-size: 11px; color: #8A8A8A; }
                        LineEdit { text <=> root.port-text; }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        Text { text: "连接方式"; font-size: 11px; color: #8A8A8A; }
                        ComboBox {
                            model: ["自动发现（USB / 局域网）", "指定 IP"];
                            current-index <=> root.mode-index;
                        }
                    }
                }

                // 指定 IP（仅在指定 IP 模式显示）
                LineEdit {
                    visible: root.mode-index == 1;
                    text <=> root.ip-text;
                    placeholder-text: "192.168.1.5";
                }

                Rectangle { height: 2px; }

                Rectangle { height: 2px; }
                CheckBox {
                    text: "开机自动启动（登录后最小化运行）";
                    checked <=> root.autostart;
                    toggled => { root.autostart-toggled(root.autostart); }
                }

                CheckBox {
                    text: "关闭窗口后最小化到托盘（后台继续等待连接）";
                    checked <=> root.tray;
                    toggled => { root.tray-toggled(root.tray); }
                }

                CheckBox {
                    text: "在右键「发送到」菜单里显示「发送到手机」";
                    checked <=> root.sendto;
                    toggled => { root.sendto-toggled(root.sendto); }
                }

                Text {
                    text: root.message;
                    visible: root.message != "";
                    font-size: 11px;
                    color: #9D5D00;
                }

                // 有新版才出现的一行
                if root.update-state == 2 : HorizontalLayout {
                    height: 30px;
                    vertical-stretch: 0;
                    spacing: 8px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #005FB8;
                    }
                    Text {
                        text: root.update-text;
                        font-size: 12px;
                        color: #005FB8;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "去下载";
                        clicked => { root.update-clicked(); }
                    }
                }

                if root.update-state == 3 : Text {
                    text: root.update-text;
                    font-size: 12px;
                    color: #005FB8;
                }

                if root.update-state == 4 : Text {
                    text: root.update-text;
                    font-size: 11px;
                    color: #9D5D00;
                }

                if root.update-state == 5 : Text {
                    text: root.update-text;
                    font-size: 11px;
                    color: #0F7B0F;
                    overflow: elide;
                }

                Divider { }

                HorizontalLayout {
                    height: 32px;
                    vertical-stretch: 0;
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    SecondaryButton {
                        label: "停止接收";
                        visible: root.running;
                        clicked => { root.stop-clicked(); }
                    }
                    PrimaryButton {
                        label: "开始接收";
                        enabled: !root.running;
                        clicked => { root.start-clicked(); }
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
    }

    // 取消接收的确认框不在这儿画了：它是独立窗口 CancelAskWindow（见文件开头），
    // 主界面和传输窗口共用那一个窗口，「继续 / 不保留 / 保留」的语义只有一份。
}
// ---------------------------------------------------------------------------
// 独立传输窗口：外观照「资源管理器复制文件」那个弹窗做
//
// 参考图 docs/explorer-copy-dialog.png（449x167，100% 缩放），下面的数都是从图上量的：
//   * 进度条：整条 395 x 15（x=27..421 / y=92..106），外面 1px #BCBCBC 描边，
//     四个角是直角（(27,92)、(421,106) 都是 #BCBCBC，没有圆角）；内高 13px，
//     轨道 #E6E6E6，已填充 #0F7B0F、左右两端同样是方的。
//   * 左右内边距 26px（图上条子从 x=27 起，客户区从 x=1 起）；
//     上下文 14px 字；大号百分比 20px；百分比行到条 13px；
//     条到分隔线 15px；分隔线 1px #E3E3E3 贯穿整窗；分隔线到「详细信息」15px。
//   * 分隔线位置：y=122（整窗 447 宽那条）。
//
// 2026-11-19 这一轮「对齐原生」用 System.Drawing 逐像素重量的（图是 100% 缩放，
// 和本机 96 DPI 同一个尺度，可以直接比）：
//   * 分隔线 #E3E3E3 —— 取 (10,122)/(200,122)/(440,122) 三个点，整行 447 个像素
//     全是 #E3E3E3，没有渐变；条底 y=106 到线 y=122 中间隔着 15 行纯白。
//     → **我们的线颜色本来就对，问题是线贴着条子画（间距 0）**，看着像进度条的
//       第二道边，所以「扎眼」。现在按图补上 15px 间距。
//   * 文字 #000000 —— 主文案 (46,50) 一带、明细行「详细信息」(60,141) 一带的最暗
//     像素都是纯黑（图上那些彩色点是 ClearType 的次像素红蓝边，不是字色）。
//     原来是 #1A1A1A，按图改成 #000000。
//   * 三角 ▼ 最暗 #1F1F1F（(31,141..147) 那条细线），本质上还是黑，和文字同色。
//   * ✕ 图标 (409..416, 64..82) 最暗 #000000；⏸ 同样 #000000。
//   * 「详细信息」那一行：三角墨迹 x=31..41、文字 x=51..98（4 个字 48px → 12px 字），
//     墨迹 y=139..149；配 22px 的行高正好是 y=133..155 这个框（行内居中），
//     也就是「分隔线 122 → 行框 133 = 10px」；文字墨迹离分隔线 15px，和上面那条对上。
//   * 参考图里没有次级灰字（正文、明细全是黑的），所以「57%」「·」那类淡色没法从图上
//     取，沿用现有的中性灰 #616161（R=G=B，本来就不存在饱和问题）。
//   * 进度条三个色在图上逐点复核过，和现在代码里的完全一致（轨道 #E6E6E6、
//     填充 #0F7B0F、描边 #BCBCBC），这一项**不需要改**，只把出处写进注释。
//
// 语义：
//   * 标题栏 ✕ 与「收起」= 把窗口藏起来，传输继续（和手机端「关闭 ≠ 取消」一样）；
//     要真停下得点窗口里的「取消」，走的是主界面那套「保留 / 不保留」；
//   * 传完亮 3 秒「已完成」自己收；
//   * 位置 / 置顶 / 记住坐标都在 gui_slint.rs（贴工作区右下角 + HWND_TOPMOST）。
// ---------------------------------------------------------------------------
export component TransferWindow inherits Window {
    title: root.failed ? "接收失败" : root.done ? "已完成" : "正在传输";
    // 和主窗口同一个字体，别让两个窗口的字长得不一样
    default-font-family: "Segoe UI, Microsoft YaHei UI";
    default-font-size: 13px;
    preferred-width: 460px;
    // 收起时的高度 = 14 + 20 + 6 + 30 + 13 + 15(条) + 15(条到线) + 1(线) + 10
    //              + 22(详细信息行) + 10 = 156
    // （2026-11-19：条到线补了 15px、百分比行到条 12→13、「详细信息」行 20→22，
    //   所以 151 → 156；gui_slint.rs 的 TW_H_COLLAPSED 同步改了）
    // 展开「详细信息」后由 Rust 按行数 set_size（和 gui_slint.rs 的 TW_H_COLLAPSED 对得上）
    //
    // 但光靠 Rust 的 set_size 不够：窗口高度最终以 Slint 这边的 preferred-height 为准，
    // 暂停着等用户选「保留 / 不保留」的时候（那时 active 已经是 false）Rust 那边调 set_size
    // 窗口并不会长 —— 真机 2026-11-17 就是这么撞见的：确认框上的「继续接收」只露出半截。
    // 所以这里把「内容需要多高」也声明一遍，和 transfer_window_height() 的公式保持一致。
    // 展开这一段只加「6px 间隔 + 每行 22px」：原来的 30px 里多算了 24px，
    // 展开后窗口底下会留一条空白（真机截图 476x352 里最后一行下面还有 40 多像素白）。
    // rows 为空时下面画的是「这一轮还没有分通道数据」那一行，同样占 22px，
    // 所以这里也用 max(1, …)，和 Rust 的 transfer_window_height() 一个算法。
    property <length> content-h: 156px
        + (root.failed ? 20px : 0px)
        + (root.details ? 6px + Math.max(1, root.rows.length) * 22px : 0px);
    // 确认框现在是独立窗口，不再需要把高度撑到 216 —— 传“细节”让位给它自己的窗口
    preferred-height: root.content-h;
    background: #FFFFFF;

    in-out property <string> action-text: "正在接收文件";
    in-out property <int> percent: 0;
    // 大号百分比后面那行小字：「210.0 MB / 3.00 GB · 82.9 MB/s」
    in-out property <string> detail-text: "";
    in-out property <bool> paused: false;
    in-out property <bool> done: false;
    // 这一轮失败了（块账本对不上 / 手机端说指纹不一致）：窗口停在「接收失败」上，
    // 不自动收 —— 用户不看见就会以为传完了（TRANSFER-WINDOW.md §2.1）。
    in-out property <bool> failed: false;
    // 失败原因，例如「缺 2 块 (#1318 #1319)」
    in-out property <string> fail-text: "";
    // 「详细信息」展开了没有
    in-out property <bool> details: false;
    // 明细：每段（每条通道）一行
    in-out property <[XferRow]> rows: [];
    // 进度条上的分段（IDM 同款切分）：每截的位置 / 宽度 / 填充比例
    in-out property <[XferSeg]> segs: [];
    // 「合计 82.9 MB/s · 剩余约 25 秒」—— 用户选了「去掉这行」，属性留着不显示，
    // Rust 那边还在算（日志/其它地方要用），界面上不再占一行高度。
    in-out property <string> summary-text: "";
    // 已填充比例（0..1，按块算）：流光只在这段里扫，别扫到灰色空条上
    in-out property <float> fill: 0.0;
    // 流光位置（0..1 循环），由 Rust 那边 16ms 的 Timer 推着走
    in-out property <float> flow: 0.0;
    // 速率掉到 0 / 暂停 / 传完了 → 流光停住（一边 0 MB/s 一边还在流，看着像卡死）
    in-out property <bool> flow-on: true;
    // 取消的确认框（和主界面那套是同一个组件、同一套 Rust 处理函数）
    in-out property <bool> cancel-ask: false;
    // 这一轮已经受理过取消：把「取消」按钮收起来（同一轮只让取消一次）
    in-out property <bool> cancelling: false;

    callback toggle-pause();
    // 收起（标题栏 ✕ 也走它）：藏窗口，传输继续
    callback close-window();
    callback toggle-details();
    // 返回 false = 这次点击被忽略（没在接收 / 已经在取消中），别弹确认框
    callback cancel-recv() -> bool;
    callback cancel-keep();
    callback cancel-discard();
    callback cancel-dismiss();

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        // ---- 上半：上下文 + 进度条（左右 26px 内边距，照参考图量：条子 x=27、客户区 x=1）----
        // 原来是 24，比原生少 2px —— 用户说「文本位置太挤」，把这 2px 还给原生。
        VerticalLayout {
            padding-left: 26px;
            padding-right: 26px;
            spacing: 0px;

            Rectangle { height: 14px; }

            Text {
                text: root.action-text;
                font-size: 14px;
                // #000000 = 参考图主文案「正在将…」那一行的最暗像素（(46,50) 一带，纯黑），
                // 原来是 #1A1A1A（比原生浅一档）
                color: #000000;
                height: 20px;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle { height: 6px; }

            HorizontalLayout {
                height: 30px;
                spacing: 6px;

                Text {
                    // 精简：不再拼「已完成 / 未完成」前缀 —— 标题栏已经说明状态，
                    // 大号数字只报百分比
                    text: root.percent + "%";
                    font-size: 20px;
                    font-weight: 600;
                    // #000000 = 参考图「已完成 8%」大字的最暗像素（(28..120, 66..79) 里的纯黑）；
                    // 失败那一行的红 #C42B1C 没动（参考图里没有失败态可采，沿用现值）
                    color: root.failed ? #C42B1C : #000000;
                    vertical-alignment: center;
                }
                Text {
                    text: root.detail-text;
                    // #616161 = 沿用现值：参考图里没有次级灰字（正文全是黑的），
                    // 这已经是中性灰（R=G=B），不存在「太鲜艳」的问题
                    font-size: 12px;
                    color: #616161;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                // 暂停 / 继续：参考图右边那两颗方框按钮，鼠标移上去才有底色
                Rectangle {
                    width: root.paused ? 36px : 30px;
                    height: 28px;
                    border-radius: 4px;
                    background: pause-ta.has-hover ? #F0F0F0 : transparent;
                    visible: !root.done;

                    // 运行中画两条竖杠（字体里不一定有 ⏸，画出来最稳）
                    // #000000 = 参考图 ⏸ 图标 (355..385, 64..82) 的最暗像素（纯黑），原来是 #1A1A1A
                    Rectangle {
                        visible: !root.paused;
                        x: 10px;
                        y: 8px;
                        width: 3px;
                        height: 12px;
                        background: #000000;
                    }
                    Rectangle {
                        visible: !root.paused;
                        x: 17px;
                        y: 8px;
                        width: 3px;
                        height: 12px;
                        background: #000000;
                    }
                    Text {
                        visible: root.paused;
                        text: "继续";
                        font-size: 12px;
                        color: #000000;
                        width: 100%;
                        height: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    // 纯图标控件：UIA 里以前什么都列不出来（里面是 Rectangle，没有可访问名），
                    // 自动化和读屏都点不到/读不出。TouchArea 上加角色 + 名字，
                    // 名字跟着状态走（和可见的「继续」一致）。
                    pause-ta := TouchArea {
                        accessible-role: button;
                        accessible-label: root.paused ? "继续" : "暂停";  // 英文：Resume / Pause
                        clicked => { root.toggle-pause(); }
                    }
                }

                // 取消：参考图右边那颗 ✕，接的是「保留 / 不保留」那套流程
                Rectangle {
                    width: 30px;
                    height: 28px;
                    border-radius: 4px;
                    background: cancel-ta.has-hover ? #F0F0F0 : transparent;
                    // 失败时也要留着这颗 ✕：它是把「接收失败」这个窗口关掉的唯一按钮
                    visible: (!root.done || root.failed) && !root.cancelling;

                    Text {
                        // × 是 GB2312 里就有的乘号，✕(U+2715) 在 YaHei 里没有，会变豆腐块
                        text: "×";
                        font-size: 18px;
                        // #000000 = 参考图右上角 ✕ 图标 (409..416, 64..82) 的最暗像素，原来是 #1A1A1A
                        color: #000000;
                        width: 100%;
                        height: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    // 纯图标控件：UIA 里以前只暴露成一颗 Text「×」，没有按钮角色。
                    // 加角色 + 名字之后自动化能按「取消接收」点到它（读屏也读得出）。
                    cancel-ta := TouchArea {
                        accessible-role: button;
                        accessible-label: "取消接收";  // 英文：Cancel
                        clicked => {
                            // 失败那一轮：这颗 ✕ 变成「关掉这个失败提示」
                            // （已经没有传输在跑了，走取消流程只会被忽略，按钮就成死的了）
                            if (root.failed) {
                                root.close-window();
                            } else if (root.cancel-recv()) {
                                // 和主界面一样：先暂停（手机端跟着停发），再问保留不保留
                                root.cancel-ask = true;
                            }
                        }
                    }
                }
            }

            // 百分比行到条 13px：参考图大字墨迹底 y=79、条顶 y=92，中间 13 行。原来是 12。
            Rectangle { height: 13px; }

            // 进度条：底是资源管理器那张参考图量出来的 —— 条高 15px、直角、1px #BCBCBC 描边、
            // 轨道 #E6E6E6、填充原生绿 #0F7B0F。
            //
            // 2026-11-19 复核（用户说「进度条配色太鲜艳」）：把参考图和本程序的截图逐点比过，
            // 三个色**一模一样**，所以这一项不改，只补出处：
            //   * 描边 #BCBCBC —— 参考图 (27,92) / (200,92) / (200,106)，条子上下各一行；
            //   * 轨道 #E6E6E6 —— 参考图 (200,93)（条内未填充区域）；
            //   * 填充 #0F7B0F —— 参考图 (200,97) / (30,93)（左边已填充那段）；
            //   本程序真机截图 xfer-window-details.png 里同位置取到的也是这三个值。
            // 最后一段 8% 的绿之所以显得艳，是「窄窄一条高饱和绿」的观感，颜色本身是原生色，
            // 改浅反而就不像资源管理器了。
            //
            // 填充规则：**分段，每段从自己的左边缘往右填**（用户定的）。
            // 每段就是某条（或某几条合并后的）通道负责的那段文件，段宽 ∝ 块数，
            // 填到哪儿 = 这段里已经落盘的块占多少。各段同时推进、跨过切分线互不影响；
            // 全部填满就是一条完整的绿杠。以前之所以看着像「从中间往两边涨」，
            // 不是这个画法的问题，是切分点算错了（未知归属在中间一分为二，见 §6.1c）。
            bar := Rectangle {
                height: 15px;
                background: #E6E6E6;
                border-width: 1px;
                border-color: #BCBCBC;
                border-radius: 0px;
                clip: true;

                // 一截一块，各填各的（段宽 ∝ 这段占整条的比例）
                for seg in root.segs : Rectangle {
                    x: 1px + (bar.width - 2px) * seg.x;
                    width: Math.max(0px, (bar.width - 2px) * seg.span);
                    height: bar.height - 2px;
                    background: transparent;
                    clip: true;

                    piece := Rectangle {
                        // x 必须显式写 0：不给 x 时 Slint 会把这个块**居中**摆进这一段，
                        // 于是每段的绿都从段中间往两边长 —— 真机上就是「进度条从中间往两边涨」
                        // （像素实测：段起点 33、段宽 68、绿的起点 64 ≈ 33 + (68-8)/2）。
                        x: 0px;
                        width: parent.width * Math.max(0.0, Math.min(1.0, seg.filled));
                        height: 100%;
                        background: #0F7B0F;
                        clip: true;

                        // 流光：**一道光扫整条**，不是每截各扫各的。
                        // 亮带位置用整条坐标算，各截只把经过自己的那段露出来（clip），
                        // 所以光从左边一路走到右边，跨切分线时是连续的。
                        // 参数照抄 Windows 原生（WPF 默认模板的 PART_GlowRect），不是随手调的：
                        //   带宽 100px；水平渐变 #00FFFFFF 0% → #60FFFFFF 40% → #60FFFFFF 60% →
                        //   #00FFFFFF 100%（0x60 = 37.6% 白，中段 40% 实心、两侧各 30% 羽化）；
                        //   匀速 200 px/s 从左边外面扫到填充区右边外面，扫完停 1 秒再从头来。
                        // 出处：dotnet/wpf Themes/XAML/ProgressBar.xaml + ProgressBar.cs 的 UpdateAnimation。
                        band := Rectangle {
                            visible: root.flow-on && piece.width > 8px;
                            private property <length> band-w: 100px;
                            x: (bar.width - 2px) * root.flow - (bar.width - 2px) * seg.x - band.band-w / 2;
                            y: 0px;
                            width: band.band-w;
                            height: 100%;
                            // 注意 Slint 的颜色是 #RRGGBBAA（最后两位是透明度）
                            background: @linear-gradient(90deg,
                                #FFFFFF00 0%,
                                #FFFFFF60 40%,
                                #FFFFFF60 60%,
                                #FFFFFF00 100%);
                        }
                    }
                }

                // 切分线画在最上面：灰底和绿底上都看得见，一条通道一截全靠它分
                for seg in root.segs : Rectangle {
                    visible: seg.x > 0.0001;
                    x: 1px + (bar.width - 2px) * seg.x;
                    width: 1px;
                    height: bar.height - 2px;
                    background: #F2F2F2;
                }
            }
        }

        // ---- 条到分隔线 15px（参考图条底 y=106、线 y=122，中间 15 行纯白）----
        // 这一段以前是 **0**：线直接贴着条子画，看着像进度条自己的第二道边，
        // 用户说的「分界线太明显」主要就是这个。加上原生那 15px 之后，线才回到
        // 「段落分隔」的位置上。
        Rectangle { height: 15px; }

        // ---- 分隔线：贯穿整窗（参考图就是整窗宽，不带内边距）----
        // #E3E3E3 = 参考图 (10,122)/(200,122)/(440,122)，整行 447 个像素全是这个值。
        // 颜色本来就是对的（不是深灰），扎眼是上面那个 0 间距造成的，所以这里只保留原色。
        Rectangle { height: 1px; background: #E3E3E3; }

        // ---- 下半：「详细信息」开关 + 明细 ----
        // 和上半一样 26px 内边距：参考图里三角的墨迹从 x=31 起、正文从 x=27 起，
        // 都在同一个 26px 的左边距上（三角字形自己带一点左侧留白）。
        VerticalLayout {
            padding-left: 26px;
            padding-right: 26px;
            spacing: 0px;

            // 分隔线到行框 10px：参考图线 y=122，22px 的行框落在 y=133..155（框内文字居中，
            // 墨迹 y=139..149），所以「线到行框 10px」= 「线到文字 15px」，
            // 后者正是顶部注释块里量的那个 15。原来是 9。
            Rectangle { height: 10px; }

            // 整行可点（和资源管理器一样，不用非得点到字上）
            // 行高 22px = Windows 列表的标准行高（原来是 20）；12px 字 = 参考图
            // 「详细信息」4 个字量出 48px 宽（x=51..98），也就是 12px 一个字。
            Rectangle {
                height: 22px;
                // 悬浮时**不刷底色**（用户 2026-11-19：「鼠标悬浮停留时这个详细信息阴影删除，
                // 或者 1:1 仿原生」）。原生资源管理器这一行确实有 hover 高亮，但我们把整行 460px
                // 刷成 #F5F5F5 之后，白底窗口里横着一条灰带，比原生那张图里任何一处都显眼 ——
                // 用户看到的就是「一道阴影」。宁可没有：可点性靠指针形状和 ▲/▼ 已经够了。
                background: transparent;

                Text {
                    // ▼/▲ 是 GB2312 里的字形，YaHei 一定有；▾/▴ 这种小三角会渲染成豆腐块
                    // 三角色同文字 #000000：参考图三角墨迹 (31..41, 141..147) 最暗 #1F1F1F，
                    // 是 12px 细笔画的抗锯齿结果，本质还是黑
                    text: root.details ? "▲ 详细信息" : "▼ 详细信息";
                    font-size: 12px;
                    color: #000000;
                    width: 100%;
                    height: 100%;
                    vertical-alignment: center;
                }
                // 这一行也是纯文字控件：UIA 里以前只是一颗 Text，自动化点不到。
                // 加按钮角色 + 跟着展开状态变的名字。
                details-ta := TouchArea {
                    accessible-role: button;
                    accessible-label: root.details ? "收起详细信息" : "展开详细信息";  // 英文：Collapse/Expand details
                    clicked => { root.toggle-details(); }
                }
            }

            if root.details : VerticalLayout {
                spacing: 0px;

                Rectangle { height: 6px; }

                // 每段（每条通道）一行：序号+通道名 / 已收 · 该段总量 / 速率 / 该段完成度
                // 通道名和手机端明细那张表同名（USB_ADB / wlan0#4），两边的读法一致。
                // 列：字号统一 12px（原来是 11.5/11 混着），列距 14px（原来是 8px），
                // 名字列 110px（原来 96）、速率列 78px（原来 74）、百分比列 44px（原来 40）。
                // 四列铺满 26px 内边距之间的整条宽度，所以左边缘 / 右边缘和上面那行
                // 「32.0 MB / 600.0 MB · 9.2 MB/s」是同一条线（用户要的对齐）。
                // 行高仍是 22px（Windows 列表的标准行高），字放大到 12px 之后行距自然松一档。
                for row in root.rows : HorizontalLayout {
                    height: 22px;
                    spacing: 14px;

                    Text {
                        text: row.name;
                        font-size: 12px;
                        color: #000000;
                        // 110px：「10. wlan0#4」这种名字要放得下（原来 96px）
                        width: 110px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // 精简：原来这里还有一列「占整条 xx%」，和最后一列（该段完成度）容易混，
                    // 而且通道多的时候这一列只是把同一件事说两遍，去掉。
                    Text {
                        text: row.amount;
                        font-size: 12px;
                        color: #000000;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: row.rate;
                        font-size: 12px;
                        // #616161 = 沿用现值（参考图里没有次级灰字可采，中性灰本来就不艳）
                        color: #616161;
                        width: 78px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: row.percent + "%";
                        font-size: 12px;
                        // #616161 = 同上，「57%」这类淡一点的字
                        color: #616161;
                        width: 44px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }

                if root.rows.length == 0 : Text {
                    text: "这一轮还没有分通道数据";
                    font-size: 12px;
                    color: #8A8A8A;
                    height: 22px;
                    vertical-alignment: center;
                }

                // 精简（用户选的）：「合计 xx · 剩余约 xx 秒」整行去掉 ——
                // 速率上面那行已经有了，剩余时间只是估算，明细下面再挂一行是多余的。
            }

            Rectangle { height: 10px; }

            // 取消确认框不再画在这里：它现在是**独立窗口**（见文件开头的 CancelAskWindow）。
            // 这里只留 cancel-ask 这个状态位，Rust 每帧读它，翻成 true 就把那个窗口弹出来。
            // 以前是遮罩层，得靠「加 65px 占位」把窗口物理撑高才露得全（§6.2），独立窗口不用。
        }
    }
}
