// 多轨快传 · 电脑接收器（Slint / fluent 样式，紧凑版）
import { Button, LineEdit, CheckBox, ComboBox } from "std-widgets.slint";

component Card inherits Rectangle {
    background: #FFFFFF;
    border-radius: 10px;
    border-width: 1px;
    border-color: #E5E5E5;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #10182810;
}

component Divider inherits Rectangle {
    height: 1px;
    background: #EDEDED;
}

component ProgressBar inherits Rectangle {
    in property <float> value: 0;
    height: 6px;
    border-radius: 3px;
    background: #E8E8E8;

    Rectangle {
        width: parent.width * Math.max(0.0, Math.min(1.0, root.value));
        height: parent.height;
        border-radius: 3px;
        background: #005FB8;
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 108px;
    height: 32px;
    border-radius: 4px;
    background: !enabled ? #E6E9ED : (ta.has-hover ? #1A6FC4 : #005FB8);

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: enabled ? #FFFFFF : #9AA4AE;
        font-size: 13.5px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component SecondaryButton inherits Rectangle {
    in property <string> label;
    callback clicked;

    width: 92px;
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #D7D7D7;
    background: ta.has-hover ? #F5F5F5 : #FFFFFF;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: #1A1A1A;
        font-size: 13.5px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea { clicked => { root.clicked(); } }
}

export struct DeviceRow {
    name: string,
    state: string,
    rate: string,
    detail: string,
    expanded: bool,
}

export struct DevicePair {
    left: DeviceRow,
    right: DeviceRow,
    has-right: bool,
}

export component AppWindow inherits Window {
    title: "多轨快传";
    icon: @image-url("logo-accent.png");
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;

    preferred-width: 560px;
    min-width: 520px;
    min-height: 260px;
    background: #F3F3F3;

    in-out property <string> status-title: "未开始接收";
    in-out property <string> status-sub: "点「开始接收」等待手机连接";
    in-out property <string> status-sub-full: "";
    in-out property <int> status-kind: 0;
    in-out property <bool> running: false;

    in-out property <string> dir-text: "";
    in-out property <string> port-text: "5740";
    in-out property <string> ip-text: "192.168.1.5";
    in-out property <int> mode-index: 0;
    in-out property <bool> autostart: false;
    in-out property <bool> tray: true;
    in-out property <string> message: "";

    // ---- 传输进度 ----
    in-out property <bool> xfer-visible: false;
    in-out property <string> file-name: "";
    in-out property <float> file-progress: 0.0;
    in-out property <string> file-text: "";
    in-out property <string> session-text: "";
    // IDM 式分块：每个元素是该段已完成比例（0..1）
    in-out property <[float]> blocks: [];
    // 多设备列表（点状态卡展开）
    in-out property <[DeviceRow]> devices: [];
    // 两两配对后的行（一行两个小卡片）
    in-out property <[DevicePair]> device-rows: [];
    in-out property <bool> devices-expanded: false;
    // 多台设备时，有文件要推送但没指定目标 → 让用户选一台
    in-out property <bool> ask-target: false;
    // 有设备可展开时才让状态卡可点
    private property <bool> has-devices: root.devices.length > 0;

    // ---- 更新检查：0 检查中 / 1 已是最新 / 2 有新版 / 3 正在下载 / 4 出错 ----
    in-out property <int> update-state: 0;
    in-out property <string> update-text: "";
    in-out property <bool> update-busy: false;

    callback update-clicked();

    callback browse-clicked();
    callback start-clicked();
    callback stop-clicked();
    callback autostart-toggled(bool);
    callback tray-toggled(bool);
    callback device-clicked(int);
    callback device-chosen(int);
    callback open-dir();

    private property <color> status-color: root.status-kind == 2 ? #0F7B0F : root.status-kind == 3 ? #9D5D00 : #8A8A8A;
    private property <string> status-text: root.status-kind == 2 ? "已连接" : root.status-kind == 3 ? "重试中" : root.status-kind == 1 ? "等待中" : "未启动";

    VerticalLayout {
        padding: 12px;
        spacing: 9px;

        // ---------------- 状态（点击展开设备） ----------------
        Card {
            vertical-stretch: 0;
            VerticalLayout {
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 12px;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: #F3F3F3;

                    // 已连接用对勾（与手机端一致），其它状态用手机图标
                    Image {
                        visible: root.status-kind == 2;
                        source: @image-url("status-check.png");
                        colorize: root.status-color;
                        width: 22px;
                        height: 22px;
                        x: 9px;
                        y: 9px;
                    }
                    Image {
                        visible: root.status-kind != 2;
                        source: @image-url("status-phone.png");
                        colorize: root.status-color;
                        width: 22px;
                        height: 22px;
                        x: 9px;
                        y: 9px;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: root.status-title; font-size: 17px; font-weight: 600; color: #1A1A1A; }
                    Text {
                        text: root.devices-expanded ? root.status-sub-full : root.status-sub;
                        font-size: 11px;
                        color: #616161;
                        overflow: elide;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.status-text;
                    font-size: 12px;
                    font-weight: 400;
                    color: root.status-color;
                    vertical-alignment: center;
                }

                if root.has-devices : Text {
                    text: root.devices-expanded ? "收起" : "展开";
                    font-size: 11px;
                    color: #8A8A8A;
                    vertical-alignment: center;
                }
            }

            // 展开后的设备：一行两个小卡片（和手机端首页的卡片风格一致）
            if (root.devices-expanded) : VerticalLayout {
                spacing: 6px;
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 10px;
                for p in root.device-rows : HorizontalLayout {
                    spacing: 6px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 46px;
                                border-radius: 10px;
                                background: #F7F7F7;
                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 2px;
                                    Text {
                                        text: p.left.name;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: #1A1A1A;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: p.left.state + "  ·  " + p.left.rate;
                                        font-size: 10.5px;
                                        color: #616161;
                                        overflow: elide;
                                    }
                                }
                            }
                    if (p.has-right) : Rectangle {
                        horizontal-stretch: 1;
                        height: 46px;
                        border-radius: 10px;
                        background: #F7F7F7;
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 2px;
                            Text {
                                text: p.right.name;
                                font-size: 12px;
                                font-weight: 600;
                                color: #1A1A1A;
                                overflow: elide;
                            }
                            Text {
                                text: p.right.state + "  ·  " + p.right.rate;
                                font-size: 10.5px;
                                color: #616161;
                                overflow: elide;
                            }
                        }
                    }
                    if (!p.has-right) : Rectangle {
                        horizontal-stretch: 1;
                        height: 46px;
                        background: transparent;
                    }
                }
            }
            }
            TouchArea {
                clicked => {
                    if (root.has-devices) {
                        root.devices-expanded = !root.devices-expanded;
                    }
                }
            }
        }

        // ---------------- 选择接收设备 ----------------
        if (root.ask-target) : Card {
            vertical-stretch: 0;
            VerticalLayout {
                width: parent.width;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 4px;

                Text {
                    text: "有文件要推送，选择接收的设备：";
                    font-size: 12px;
                    color: #1A1A1A;
                }
                for d[i] in root.devices : HorizontalLayout {
                    height: 26px;
                    spacing: 8px;
                    Text {
                        text: d.name;
                        font-size: 12px;
                        color: #1A1A1A;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "发送到这台";
                        clicked => { root.device-chosen(i); }
                    }
                }
            }
        }

        // ---------------- 进度（传输时才存在） ----------------
        if root.xfer-visible : Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 6px;

                HorizontalLayout {
                    height: 18px;
                    Text { text: "当前文件"; font-size: 11px; color: #8A8A8A; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.file-text; font-size: 11px; color: #1A1A1A; vertical-alignment: center; }
                }

                Text {
                    text: root.file-name;
                    font-size: 12.5px;
                    color: #1A1A1A;
                    overflow: elide;
                }

                // 分段进度条：每格代表一段文件范围，收到即填满（类似 IDM 的分块图）
                HorizontalLayout {
                    height: 14px;
                    spacing: 1px;
                    for seg in root.blocks : Rectangle {
                        horizontal-stretch: 1;
                        background: #EAEAEA;
                        Rectangle {
                            width: parent.width * seg;
                            height: parent.height;
                            background: #005FB8;
                        }
                    }
                }

                Text {
                    text: root.session-text;
                    font-size: 11px;
                    color: #616161;
                }
            }
        }

        // ---------------- 设置 ----------------
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 6px;

                // 接收文件夹：标签在上，输入框自适应
                Text { text: "接收文件夹"; font-size: 11px; color: #8A8A8A; }
                HorizontalLayout {
                    height: 30px;
                    vertical-stretch: 0;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.dir-text;
                        placeholder-text: "D:\\接收文件夹";
                    }
                    Button { text: "浏览…"; clicked => { root.browse-clicked(); } }
                    Button { text: "打开"; clicked => { root.open-dir(); } }
                }

                Divider { }

                // 端口 / 连接方式
                HorizontalLayout {
                    spacing: 14px;
                    vertical-stretch: 0;

                    VerticalLayout {
                        width: 110px;
                        spacing: 3px;
                        Text { text: "端口"; font-size: 11px; color: #8A8A8A; }
                        LineEdit { text <=> root.port-text; }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        Text { text: "连接方式"; font-size: 11px; color: #8A8A8A; }
                        ComboBox {
                            model: ["自动发现（USB / 局域网）", "指定 IP"];
                            current-index <=> root.mode-index;
                        }
                    }
                }

                // 指定 IP（仅在指定 IP 模式显示）
                LineEdit {
                    visible: root.mode-index == 1;
                    text <=> root.ip-text;
                    placeholder-text: "192.168.1.5";
                }

                Rectangle { height: 2px; }

                Rectangle { height: 2px; }
                CheckBox {
                    text: "开机自动启动（登录后最小化运行）";
                    checked <=> root.autostart;
                    toggled => { root.autostart-toggled(root.autostart); }
                }

                CheckBox {
                    text: "关闭窗口后最小化到托盘（后台继续等待连接）";
                    checked <=> root.tray;
                    toggled => { root.tray-toggled(root.tray); }
                }

                Text {
                    text: root.message;
                    visible: root.message != "";
                    font-size: 11px;
                    color: #9D5D00;
                }

                // 有新版才出现的一行
                if root.update-state == 2 : HorizontalLayout {
                    height: 30px;
                    vertical-stretch: 0;
                    spacing: 8px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #005FB8;
                    }
                    Text {
                        text: root.update-text;
                        font-size: 11.5px;
                        color: #005FB8;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "去下载";
                        clicked => { root.update-clicked(); }
                    }
                }

                if root.update-state == 3 : Text {
                    text: root.update-text;
                    font-size: 11.5px;
                    color: #005FB8;
                }

                if root.update-state == 4 : Text {
                    text: root.update-text;
                    font-size: 11px;
                    color: #9D5D00;
                }

                if root.update-state == 5 : Text {
                    text: root.update-text;
                    font-size: 10.5px;
                    color: #0F7B0F;
                    overflow: elide;
                }

                Divider { }

                HorizontalLayout {
                    height: 32px;
                    vertical-stretch: 0;
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    SecondaryButton {
                        label: "停止接收";
                        visible: root.running;
                        clicked => { root.stop-clicked(); }
                    }
                    PrimaryButton {
                        label: "开始接收";
                        enabled: !root.running;
                        clicked => { root.start-clicked(); }
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}