// 多轨快传 · 电脑接收器（Slint / fluent 样式，紧凑版）
import { Button, LineEdit, CheckBox, ComboBox, ScrollView } from "std-widgets.slint";

component Card inherits Rectangle {
    background: #FFFFFF;
    border-radius: 10px;
    border-width: 1px;
    border-color: #E5E5E5;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #10182810;
}

component Divider inherits Rectangle {
    height: 1px;
    background: #EDEDED;
}

component ProgressBar inherits Rectangle {
    in property <float> value: 0;
    height: 6px;
    border-radius: 3px;
    background: #E8E8E8;

    Rectangle {
        width: parent.width * Math.max(0.0, Math.min(1.0, root.value));
        height: parent.height;
        border-radius: 3px;
        background: #005FB8;
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 108px;
    height: 32px;
    border-radius: 4px;
    background: !enabled ? #E6E9ED : (ta.has-hover ? #1A6FC4 : #005FB8);

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: enabled ? #FFFFFF : #9AA4AE;
        font-size: 13px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component SecondaryButton inherits Rectangle {
    in property <string> label;
    callback clicked;

    width: 92px;
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #D7D7D7;
    background: ta.has-hover ? #F5F5F5 : #FFFFFF;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: #1A1A1A;
        font-size: 13px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea { clicked => { root.clicked(); } }
}

// 取消确认框（CancelAskWindow）专用的按钮：照 Windows 11 对话框那颗的样子画 ——
// 浅灰底 + 1px 细边框 + 深色字，**不上蓝底**。
//
// 为什么主按钮（默认那颗）也不上蓝：①这一轮用户的要求就是「降饱和」；
// ②这颗按钮代表的是「保留进度」，不是「马上要执行的操作」，蓝底会把眼睛从
//   「取消接收？」这个问句上拽走；③经典 Win32 MessageBox 的默认按钮本来就是
//   灰底 + 粗字 + 更实的描边，Win11 只是把描边换成细的 #D0D0D0。
//   要恢复成 Win11 的强调色主按钮，把下面 primary 那两行的底色换成 #0067C0、
//   文字换成 #FFFFFF 即可（一行的事，不动布局）。
//
// 颜色出处：
//   * 次按钮底色 #FAFAFA、边框 #D0D0D0 = Windows 11 ContentDialog 的实测值（用户给的）；
//   * hover #F5F5F5 是从 #FAFAFA 往下压一档，和按钮自己的常态拉开明度差
//     （原生按钮的 hover 就是这么来的，压的是明度，不动色相）；
//   * 默认那颗 #F0F0F0 / hover #E8E8E8：比次按钮再深一档，配合加粗字，一眼看出它是默认项。
component AskButton inherits Rectangle {
    in property <string> label;
    // true = 默认按钮（灰底深一档 + 加粗），false = 普通按钮
    in property <bool> primary: false;
    callback clicked;

    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #D0D0D0;
    background: root.primary
        ? (ta.has-hover ? #E8E8E8 : #F0F0F0)
        : (ta.has-hover ? #F5F5F5 : #FAFAFA);

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        // #000000 = 参考图 docs/explorer-copy-dialog.png 文字的最暗像素（(60,141)、(46,50)）
        color: #000000;
        font-size: 13px;
        font-weight: root.primary ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea { clicked => { root.clicked(); } }
}

export struct DeviceRow {
    name: string,
    state: string,
    rate: string,
    detail: string,
    expanded: bool,
}

export struct DevicePair {
    left: DeviceRow,
    right: DeviceRow,
    has-right: bool,
}

// 「详细信息」里的每一行：一段 = 一条通道负责的连续块区间
// （数据源是 PROGRESS.segments()，电脑端目前没有"每通道速率"，所以这里只有
//  占整条多少 + 这段自己收了多少 —— 不编数据）
export struct XferRow {
    name: string,
    // 这一段占整条的比例，如 "24%"
    span-text: string,
    // 这一段自己：已收 / 该段总量
    amount: string,
    // 这一段自己的速率（「—」= 这一秒没动静）
    rate: string,
    // 这一段完成百分比 0..100
    percent: int,
}

// 进度条上的「一截」：IDM 那种一条杠被切成几截、各自往前跑的画法。
// 每截的位置和宽度都是相对整条的比例（0..1），填了多少也是比例。
export struct XferSeg {
    // 这一截从整条的哪个位置开始
    x: float,
    // 占整条多少
    span: float,
    // 这一截自己填了多少（0..1）
    filled: float,
}

// （取消确认框的旧遮罩组件已删除：现在是独立窗口 CancelAskWindow，见下面。）
// 取消接收的确认框：**独立窗口**（用户要求，不要挤在传输窗口里）。
//
// 以前它是传输窗口上的一个遮罩层，得靠「给布局加 65px 占位」把窗口物理撑高才露得全
// （Slint 的窗口高度取根布局需求，set_size 会被夹回去，见 TRANSFER-WINDOW.md §6.2）。
// 独立窗口不用跟布局较劲：自己的尺寸自己说了算，传输窗口该多高还是多高；
// 也不会挡住传输窗口上的暂停/取消按钮 —— 用户可以先处理完这个框再说。
export component CancelAskWindow inherits Window {
    // 两个方向共用这一张确认框，问的是同一件事：「半截文件怎么处置」。
    // 差别只在半截文件在哪一头 —— 接收方向在电脑上，发送方向在手机上
    // （手机上那份由 CANCEL_DISCARD 让它删掉）。
    in-out property <bool> sending: false;
    title: root.sending ? "取消发送" : "取消接收";
    width: 424px;
    height: 172px;
    // 标题栏 ✕ 当成「继续接收」（不改主意）：这个回调挂不了在 Window 上，
    // 由 gui_slint.rs 用 on_close_requested 接（和传输窗口的 ✕ 一个路子）。

    callback keep();
    callback discard();
    callback dismiss();

    Rectangle {
        width: 100%;
        height: 100%;
        // 底色 #FFFFFF = 参考图 docs/explorer-copy-dialog.png 客户区 (5,60) 取的，
        // 原生对话框就是纯白，不用再压（原来的 #FFFFFF 本来就对，保留并注明出处）
        background: #FFFFFF;
        border-width: 1px;
        // #D0D0D0 = Windows 11 控件的细描边（用户给的 ContentDialog 值），原来是 #C8C8C8；
        // 压淡一档是为了和「浅灰底按钮」同一套灰度，别让边框抢眼
        border-color: #D0D0D0;

        VerticalLayout {
            padding: 16px;
            spacing: 8px;

            Text {
                text: root.sending ? "取消发送？" : "取消接收？";
                font-size: 15px;
                font-weight: 600;
                // #000000 = 参考图正文文字的最暗像素（(60,141)、(46,50)），原来是 #1A1A1A
                color: #000000;
            }
            Text {
                text: root.sending
                    ? "手机上已经收到的部分怎么处理？（选好之后就停，这几秒传输先照常跑）"
                    : "已经收到的部分怎么处理？（选好之后就停，这几秒传输先照常跑）";
                font-size: 12px;
                color: #616161;
                wrap: word-wrap;
            }
            Text {
                text: root.sending
                    ? "保留进度：手机留着已收到的部分，下次接着传；不保留：让手机删掉。"
                    : "保留进度：留半截文件和续传记录，下次接着传；不保留：删掉。";
                font-size: 12px;
                color: #8A8A8A;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                height: 32px;
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                // 三颗都用 AskButton：浅灰底 + 细边框 + 深色字（见文件上半部分的组件注释）。
                // 以前是 SecondaryButton(#FFFFFF) + PrimaryButton(#005FB8 蓝底白字)，
                // 那颗蓝底就是用户说的「太鲜艳」；现在默认项只用「深一档的灰 + 加粗」表示。
                AskButton {
                    width: 92px;
                    label: root.sending ? "继续发送" : "继续接收";
                    clicked => { root.dismiss(); }
                }
                AskButton {
                    width: 128px;
                    label: "不保留，删掉";
                    clicked => { root.discard(); }
                }
                AskButton {
                    width: 104px;
                    label: "保留进度";
                    primary: true;
                    clicked => { root.keep(); }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "多轨快传";
    icon: @image-url("logo-accent.png");
    default-font-family: "Segoe UI, Microsoft YaHei UI";
    default-font-size: 13px;

    preferred-width: 560px;
    min-width: 520px;
    min-height: 260px;
    background: #F3F3F3;

    in-out property <string> status-title: "未开始接收";
    in-out property <string> status-sub: "点「开始接收」等待手机连接";
    in-out property <string> status-sub-full: "";
    in-out property <int> status-kind: 0;
    in-out property <bool> running: false;

    in-out property <string> dir-text: "";
    in-out property <string> port-text: "5740";
    in-out property <string> ip-text: "192.168.1.5";
    in-out property <int> mode-index: 0;
    in-out property <bool> autostart: false;
    in-out property <bool> tray: true;
    // 右键「发送到」里显示「发送到手机」
    in-out property <bool> sendto: false;
    // 本机限速（MB/s，0 = 不限速）。和手机端的设置互相协商，取非零里较小的一个。
    // 存成字符串而不是 int：输入框里允许「还没输完」的空串 / 半截数字，
    // 边输边转 int 会把中间态吞掉（用户输 10 时先清空，那一瞬会被当成 0 存下来）。
    in-out property <string> speed-limit-text: "0";
    // 限速输入框现在有没有焦点。LineEdit 的 has-focus 是 out property，
    // 不能直接在上面挂 changed，所以先绑到这个本地属性上，由下面的 changed 监听。
    private property <bool> limit-focus: limit-edit.has-focus;
    // 失去焦点 = 用户点到别处了 → 提交一次。回车走 limit-edit 自己的 accepted。
    changed limit-focus => {
        if (!limit-focus) { root.speed-limit-changed(root.speed-limit-text); }
    }
    in-out property <string> message: "";
    // 状态卡下面的一行结果提示（取消接收后那句「已保留进度」/「已删除未完成文件」）
    in-out property <string> notice-text: "";

    // ---- 传输进度 ----
    in-out property <bool> xfer-visible: false;
    // 手机正在从电脑取文件（显示暂停/中断按钮）
    in-out property <bool> send-active: false;
    // 正在接收手机推过来的文件（显示暂停 / 取消按钮）
    in-out property <bool> recv-active: false;
    // 取消接收的确认框：保留进度 / 不保留（删掉未完成文件）/ 继续接收
    in-out property <bool> cancel-ask: false;
    // 这次接收的「取消」已经受理过（收尾 / 重建还在进行）：把按钮收起来，
    // 同一轮接收只允许取消一次 —— 第二次点击如果照样往控制通道插帧，
    // 会和手机端正在做的重建握手抢帧序（手机端报 unexpected control frame）。
    in-out property <bool> recv-cancelling: false;
    in-out property <bool> send-paused: false;
    in-out property <string> file-name: "";
    in-out property <float> file-progress: 0.0;
    in-out property <string> file-text: "";
    in-out property <string> session-text: "";
    // 多设备列表（点状态卡展开）
    in-out property <[DeviceRow]> devices: [];
    // 两两配对后的行（一行两个小卡片）
    in-out property <[DevicePair]> device-rows: [];
    in-out property <bool> devices-expanded: false;
    // 多台设备时，有文件要推送但没指定目标 → 让用户选一台
    in-out property <bool> ask-target: false;
    // 有设备可展开时才让状态卡可点
    private property <bool> has-devices: root.devices.length > 0;

    // ---- 更新检查：0 检查中 / 1 已是最新 / 2 有新版 / 3 正在下载 / 4 出错 ----
    in-out property <int> update-state: 0;
    in-out property <string> update-text: "";
    in-out property <bool> update-busy: false;

    callback update-clicked();

    callback browse-clicked();
    callback start-clicked();
    callback stop-clicked();
    callback autostart-toggled(bool);
    callback tray-toggled(bool);
    callback sendto-toggled(bool);
    callback speed-limit-changed(string);
    callback device-clicked(int);
    callback device-chosen(int);
    callback toggle-pause-send();
    callback cancel-send();
    // 接收方向的取消：点「取消」先暂停并弹确认框，再按用户的选择收尾。
    // 返回 false = 这次点击被忽略（没有在接收 / 已经在取消中），别弹确认框。
    callback cancel-recv() -> bool;
    callback cancel-keep();
    callback cancel-discard();
    callback cancel-dismiss();
    callback open-dir();

    private property <color> status-color: root.status-kind == 2 ? #0F7B0F : root.status-kind == 3 ? #9D5D00 : #8A8A8A;
    private property <string> status-text: root.status-kind == 2 ? "已连接" : root.status-kind == 3 ? "重试中" : root.status-kind == 1 ? "等待中" : "未启动";

    ScrollView {
    VerticalLayout {
        padding: 12px;
        spacing: 9px;

        // ---------------- 状态（点击展开设备） ----------------
        Card {
            vertical-stretch: 0;
            VerticalLayout {
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 12px;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: #F3F3F3;

                    // 已连接用对勾（与手机端一致），其它状态用手机图标
                    Image {
                        visible: root.status-kind == 2;
                        source: @image-url("status-check.png");
                        colorize: root.status-color;
                        width: 22px;
                        height: 22px;
                        x: 9px;
                        y: 9px;
                    }
                    Image {
                        visible: root.status-kind != 2;
                        source: @image-url("status-phone.png");
                        colorize: root.status-color;
                        width: 22px;
                        height: 22px;
                        x: 9px;
                        y: 9px;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: root.status-title; font-size: 17px; font-weight: 600; color: #1A1A1A; }
                    Text {
                        text: root.devices-expanded ? root.status-sub-full : root.status-sub;
                        font-size: 11px;
                        color: #616161;
                        // 收起时单行省略；展开后换行显示完整通道列表
                        wrap: root.devices-expanded ? word-wrap : no-wrap;
                        overflow: root.devices-expanded ? clip : elide;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.status-text;
                    font-size: 12px;
                    font-weight: 400;
                    color: root.status-color;
                    vertical-alignment: center;
                }

                if root.has-devices : Text {
                    text: root.devices-expanded ? "收起" : "展开";
                    font-size: 11px;
                    color: #8A8A8A;
                    vertical-alignment: center;
                }
            }

            // 取消接收之后的一句结果提示（保留进度 / 已删除未完成文件），
            // 下一次传输开始、或重新点「开始接收」时自动消失
            if root.notice-text != "" : VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-bottom: 10px;
                Text {
                    text: root.notice-text;
                    font-size: 12px;
                    color: #0F7B0F;
                    wrap: word-wrap;
                }
            }

            // 展开后的设备：一行两个小卡片（和手机端首页的卡片风格一致）
            if (root.devices-expanded) : VerticalLayout {
                spacing: 6px;
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 10px;
                for p in root.device-rows : HorizontalLayout {
                    spacing: 6px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 46px;
                                border-radius: 10px;
                                background: #F7F7F7;
                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 2px;
                                    alignment: center;
                                    Text {
                                        text: p.left.name;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: #1A1A1A;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: p.left.state + "  ·  " + p.left.rate;
                                        font-size: 11px;
                                        color: #616161;
                                        overflow: elide;
                                    }
                                }
                            }
                    if (p.has-right) : Rectangle {
                        horizontal-stretch: 1;
                        height: 46px;
                        border-radius: 10px;
                        background: #F7F7F7;
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 2px;
                            alignment: center;
                            Text {
                                text: p.right.name;
                                font-size: 12px;
                                font-weight: 600;
                                color: #1A1A1A;
                                overflow: elide;
                            }
                            Text {
                                text: p.right.state + "  ·  " + p.right.rate;
                                font-size: 11px;
                                color: #616161;
                                overflow: elide;
                            }
                        }
                    }
                    if (!p.has-right) : Rectangle {
                        horizontal-stretch: 1;
                        height: 46px;
                        background: transparent;
                    }
                }
            }
            }
            TouchArea {
                clicked => {
                    if (root.has-devices) {
                        root.devices-expanded = !root.devices-expanded;
                    }
                }
            }
        }

        // ---------------- 选择接收设备 ----------------
        if (root.ask-target) : Card {
            vertical-stretch: 0;
            VerticalLayout {
                width: parent.width;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 4px;

                Text {
                    text: "有文件要推送，选择接收的设备：";
                    font-size: 12px;
                    color: #1A1A1A;
                }
                for d[i] in root.devices : HorizontalLayout {
                    height: 26px;
                    spacing: 8px;
                    Text {
                        text: d.name;
                        font-size: 12px;
                        color: #1A1A1A;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "发送到这台";
                        clicked => { root.device-chosen(i); }
                    }
                }
            }
        }

        // 进度卡已经从主界面删掉（用户：「接收器里的进度条 ui 直接去掉」）。
        // 传输进度只在独立的 TransferWindow 里看 —— 那里才是主角，主窗口只留设备 / 设置 / 提示。
        // 下面的 file-text / session-text / xfer-visible 这些属性和回调还留着：
        // gui_slint.rs 还在往里喂（一张卡换一种画法时不用改协议层），只是没人画了。

        // ---------------- 设置 ----------------
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 6px;

                // 接收文件夹：标签在上，输入框自适应
                Text { text: "接收文件夹"; font-size: 11px; color: #8A8A8A; }
                HorizontalLayout {
                    height: 30px;
                    vertical-stretch: 0;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.dir-text;
                        placeholder-text: "D:\\接收文件夹";
                    }
                    Button { text: "浏览…"; clicked => { root.browse-clicked(); } }
                    Button { text: "打开"; clicked => { root.open-dir(); } }
                }

                Divider { }

                // 端口 / 连接方式
                HorizontalLayout {
                    spacing: 14px;
                    vertical-stretch: 0;

                    VerticalLayout {
                        width: 110px;
                        spacing: 3px;
                        Text { text: "端口"; font-size: 11px; color: #8A8A8A; }
                        LineEdit { text <=> root.port-text; }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        Text { text: "连接方式"; font-size: 11px; color: #8A8A8A; }
                        ComboBox {
                            model: ["自动发现（USB / 局域网）", "指定 IP"];
                            current-index <=> root.mode-index;
                        }
                    }
                }

                // 指定 IP（仅在指定 IP 模式显示）
                LineEdit {
                    visible: root.mode-index == 1;
                    text <=> root.ip-text;
                    placeholder-text: "192.168.1.5";
                }

                Rectangle { height: 2px; }

                Rectangle { height: 2px; }
                CheckBox {
                    text: "开机自动启动（登录后最小化运行）";
                    checked <=> root.autostart;
                    toggled => { root.autostart-toggled(root.autostart); }
                }

                CheckBox {
                    text: "关闭窗口后最小化到托盘（后台继续等待连接）";
                    checked <=> root.tray;
                    toggled => { root.tray-toggled(root.tray); }
                }

                CheckBox {
                    text: "在右键「发送到」菜单里显示「发送到手机」";
                    checked <=> root.sendto;
                    toggled => { root.sendto-toggled(root.sendto); }
                }

                // 限速：和手机端的同一个设置互相协商，取非零里较小的一个。
                // 「0 = 不限速」必须写在标签上：填 0 不等于限到 0，
                // 这是本协议里唯一一个「0 有特殊含义」的字段，不写清楚会被理解反。
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "限速";
                        font-size: 12px;
                        color: #444444;
                        vertical-alignment: center;
                    }
                    // 提交时机：**回车** 或 **点到框外失焦**，不是边打边存。
                    //
                    // 原来接的是 edited —— LineEdit 的 edited 每敲一个键就发一次
                    // （i-slint-core/items/text.rs 里每次文本改动都 TriggerCallbacks），
                    // 于是输入「25」会先按「2」存一遍配置再按「25」存一遍：配置被写两次、
                    // 界面上的值在打字途中来回跳，而且中途那个「2」如果正好赶上一轮握手，
                    // 就会用 2 MB/s 去跟手机协商。
                    //
                    // accepted 对应回车（Enter），limit-focus 由真变假对应「点了别处」，
                    // 两者各存一次，语义和原生 Windows 的输入框一致。
                    limit-edit := LineEdit {
                        width: 64px;
                        text <=> root.speed-limit-text;
                        placeholder-text: "0";
                        accepted => { root.speed-limit-changed(root.speed-limit-text); }
                    }
                    Text {
                        text: "MB/s（0 = 不限速，与手机端取较小值）";
                        font-size: 11px;
                        color: #8A8A8A;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }

                Text {
                    text: root.message;
                    visible: root.message != "";
                    font-size: 11px;
                    color: #9D5D00;
                }

                // 有新版才出现的一行
                if root.update-state == 2 : HorizontalLayout {
                    height: 30px;
                    vertical-stretch: 0;
                    spacing: 8px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #005FB8;
                    }
                    Text {
                        text: root.update-text;
                        font-size: 12px;
                        color: #005FB8;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "去下载";
                        clicked => { root.update-clicked(); }
                    }
                }

                if root.update-state == 3 : Text {
                    text: root.update-text;
                    font-size: 12px;
                    color: #005FB8;
                }

                if root.update-state == 4 : Text {
                    text: root.update-text;
                    font-size: 11px;
                    color: #9D5D00;
                }

                if root.update-state == 5 : Text {
                    text: root.update-text;
                    font-size: 11px;
                    color: #0F7B0F;
                    overflow: elide;
                }

                Divider { }

                HorizontalLayout {
                    height: 32px;
                    vertical-stretch: 0;
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    SecondaryButton {
                        label: "停止接收";
                        visible: root.running;
                        clicked => { root.stop-clicked(); }
                    }
                    PrimaryButton {
                        label: "开始接收";
                        enabled: !root.running;
                        clicked => { root.start-clicked(); }
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
    }

    // 取消接收的确认框不在这儿画了：它是独立窗口 CancelAskWindow（见文件开头），
    // 主界面和传输窗口共用那一个窗口，「继续 / 不保留 / 保留」的语义只有一份。
}
// ---------------------------------------------------------------------------
// 独立传输窗口：外观照「资源管理器复制文件」那个弹窗做
//
// 参考图 docs/explorer-copy-dialog.png（449x167，100% 缩放），下面的数都是从图上量的：
//   * 进度条：整条 395 x 15（x=27..421 / y=92..106），外面 1px #BCBCBC 描边，
//     四个角是直角（(27,92)、(421,106) 都是 #BCBCBC，没有圆角）；内高 13px，
//     轨道 #E6E6E6，已填充 #0F7B0F、左右两端同样是方的。
//   * 左右内边距 26px（图上条子从 x=27 起，客户区从 x=1 起）；
//     上下文 14px 字；大号百分比 20px；百分比行到条 13px；
//     条到分隔线 15px；分隔线 1px #E3E3E3 贯穿整窗；分隔线到「详细信息」15px。
//   * 分隔线位置：y=122（整窗 447 宽那条）。
//
// 2026-11-19 这一轮「对齐原生」用 System.Drawing 逐像素重量的（图是 100% 缩放，
// 和本机 96 DPI 同一个尺度，可以直接比）：
//   * 分隔线 #E3E3E3 —— 取 (10,122)/(200,122)/(440,122) 三个点，整行 447 个像素
//     全是 #E3E3E3，没有渐变；条底 y=106 到线 y=122 中间隔着 15 行纯白。
//     → **我们的线颜色本来就对，问题是线贴着条子画（间距 0）**，看着像进度条的
//       第二道边，所以「扎眼」。现在按图补上 15px 间距。
//   * 文字 #000000 —— 主文案 (46,50) 一带、明细行「详细信息」(60,141) 一带的最暗
//     像素都是纯黑（图上那些彩色点是 ClearType 的次像素红蓝边，不是字色）。
//     原来是 #1A1A1A，按图改成 #000000。
//   * 三角 ▼ 最暗 #1F1F1F（(31,141..147) 那条细线），本质上还是黑，和文字同色。
//   * ✕ 图标 (409..416, 64..82) 最暗 #000000；⏸ 同样 #000000。
//   * 「详细信息」那一行：三角墨迹 x=31..41、文字 x=51..98（4 个字 48px → 12px 字），
//     墨迹 y=139..149；配 22px 的行高正好是 y=133..155 这个框（行内居中），
//     也就是「分隔线 122 → 行框 133 = 10px」；文字墨迹离分隔线 15px，和上面那条对上。
//   * 参考图里没有次级灰字（正文、明细全是黑的），所以「57%」「·」那类淡色没法从图上
//     取，沿用现有的中性灰 #616161（R=G=B，本来就不存在饱和问题）。
//   * 进度条三个色在图上逐点复核过，和现在代码里的完全一致（轨道 #E6E6E6、
//     填充 #0F7B0F、描边 #BCBCBC），这一项**不需要改**，只把出处写进注释。
//
// 语义：
//   * 标题栏 ✕ 与「收起」= 把窗口藏起来，传输继续（和手机端「关闭 ≠ 取消」一样）；
//     要真停下得点窗口里的「取消」，走的是主界面那套「保留 / 不保留」；
//   * 传完亮 3 秒「已完成」自己收；
//   * 位置 / 置顶 / 记住坐标都在 gui_slint.rs（贴工作区右下角 + HWND_TOPMOST）。
// ---------------------------------------------------------------------------
export component TransferWindow inherits Window {
    title: root.failed ? "接收失败" : root.done ? "已完成" : "正在传输";
    // 和主窗口同一个字体，别让两个窗口的字长得不一样
    default-font-family: "Segoe UI, Microsoft YaHei UI";
    default-font-size: 13px;
    preferred-width: 460px;
    // ---- 高度：这里和 gui_slint.rs 的 transfer_window_height() 两处必须一模一样 ----
    // 收起态（2026-11-19 那一轮逐像素量出来的，这一轮一个字都没改）：
    //   14(上留白) + 20(主文案) + 6 + 30(百分比行)
    //   + 13(百分比行到分段条) + 15(分段条) + 15(分段条到分隔线)
    //   + 1(分隔线) + 10(线到开关行) + 22(「详细信息」行) + 10(下留白) = 156
    //
    // 展开态（这一轮重排，用户拍板：展开后顶上那条分段条整块不画，只留详情里那条图表条）：
    //   14 + 20 + 6 + 30                        = 70  ← 上半原样，只是 13+15(条)+15 这 43px 没了
    //   + 13(分段条不画了，百分比行到分隔线仍留 13 的呼吸)
    //   + 1(分隔线)
    //   + 10(分隔线到「名称：」)
    //   + 18*3(名称 / 剩余时间 / 剩余项目 —— 原生这三行的行距就是 18，见下面的量测注释)
    //   + 8(三行到速度图表条)
    //   + 80(速度图表条 —— 参考图 native-details.png y=92..171 逐行数的，不是 79：
    //        y=92 外框 / 93 内侧 / 94..141 上层48 / 142 黑基线 / 143..169 下层实心27 /
    //        170 内侧 / 171 外框，一共 80 行；y=172 起是纯白，所以条子就是 80 高)
    //   + 8(图表条到各通道速率第一行)
    //   + 22*max(1,rows)(每条通道一行；rows 为 0 时画「还没有分通道数据」那行，同样 22)
    //   + 10(行区下留白) + 1(「简略信息」上面那条分隔线，native-details.png y=250)
    //   + 10 + 22(行) + 10
    //   合计 = 297 + 22*max(1, rows)
    //   （拆开验算：70(上半) + 1(分隔线) + 13 + 160(详情固定 10+18*3+8+80+8)
    //     + 22*rows + 53(尾部 10+1+10+22+10)）
    // （「接收失败：<原因>」那行红字 +20，收起 / 展开两种状态都加。）
    //
    // 光靠 Rust 的 set_size 不够：窗口高度最终以这边的 preferred-height 为准，
    // 暂停着等用户选「保留 / 不保留」时（active 已经是 false）Rust 调 set_size 窗口不会长
    // —— 2026-11-17 真机撞见过「继续接收」只露出半截。所以内容高度这里也声明一遍。
    property <length> content-h: (root.failed ? 20px : 0px)
        + (root.details ? 297px + Math.max(1, root.rows.length) * 22px : 156px);
    // 确认框现在是独立窗口，不再需要把高度撑到 216 —— 传“细节”让位给它自己的窗口
    preferred-height: root.content-h;
    background: #FFFFFF;

    in-out property <string> action-text: "正在接收文件";
    in-out property <int> percent: 0;
    // 大号百分比后面那行小字：「210.0 MB / 3.00 GB · 82.9 MB/s」
    in-out property <string> detail-text: "";
    // ---- 展开「详细信息」里那三行「标签：值」的**值**（标签固定在 Slint 这边，和原生一致）----
    // 参考图 native-details.png：「名称： vendor_boot_b.img / 剩余时间：正在计算... /
    // 剩余项目： 1 (17.0 MB)」三行，12px 黑字、行距 18px，左边距和正文同一条线（x=27）。
    // 名称：当前文件名
    in-out property <string> file-name: "";
    // 剩余时间：算得出来是「x 秒 / x 分 x 秒」，算不出来由 Rust 传「正在计算...」
    in-out property <string> eta-text: "";
    // 剩余项目：剩余项数 + 剩余大小，例如「1 (17.0 MB)」
    in-out property <string> remain-text: "";
    // ---- 展开态那条「速度图表条」里的曲线面积 ----
    // Rust 每 100ms 往环形缓冲里塞一个 (进度比例, 瞬时速度)，再拼成 Path 的 commands
    // 推过来。坐标是归一化的：x 0..1000、y 0..76（76 = 图表主体高度，面积下沿压在主体现底沿），
    // Path 的 viewbox 也是 1000×76，纵向 1:1，横向拉伸到条内宽。
    // 面积的右边界 = 最后一个采样点（= 当时进度），所以**未完成区间里没有面积**。
    in-out property <string> curve-path: "";
    // 黑线（速度基准线）在主体里的 y：0 = 顶、76 = 底。由 Rust 按「当前速度 / 量程」算，
    // 原生实测这条线每帧都在动（速度越快线越高），不是画死在中间的一条装饰线。
    in-out property <float> guide-y: 75.0;
    // 图表条里那行「速度: 72.9 MB/秒」：**底边恒在黑线上方 6px**（原生实测 4 帧都是 6px），
    // 所以它会跟着黑线上下走，不是一个固定位置的标签。
    in-out property <string> speed-text: "";
    in-out property <bool> paused: false;
    in-out property <bool> done: false;
    // 这一轮失败了（块账本对不上 / 手机端说指纹不一致）：窗口停在「接收失败」上，
    // 不自动收 —— 用户不看见就会以为传完了（TRANSFER-WINDOW.md §2.1）。
    in-out property <bool> failed: false;
    // 失败原因，例如「缺 2 块 (#1318 #1319)」
    in-out property <string> fail-text: "";
    // 「详细信息」展开了没有
    in-out property <bool> details: false;
    // 明细：每段（每条通道）一行
    in-out property <[XferRow]> rows: [];
    // 进度条上的分段（IDM 同款切分）：每截的位置 / 宽度 / 填充比例
    in-out property <[XferSeg]> segs: [];
    // 「合计 82.9 MB/s · 剩余约 25 秒」—— 用户选了「去掉这行」，属性留着不显示，
    // Rust 那边还在算（日志/其它地方要用），界面上不再占一行高度。
    in-out property <string> summary-text: "";
    // 已填充比例（0..1，按块算）：流光只在这段里扫，别扫到灰色空条上
    in-out property <float> fill: 0.0;
    // 流光位置（0..1 循环），由 Rust 那边 16ms 的 Timer 推着走
    in-out property <float> flow: 0.0;
    // 速率掉到 0 / 暂停 / 传完了 → 流光停住（一边 0 MB/s 一边还在流，看着像卡死）
    in-out property <bool> flow-on: true;
    // 这一轮是「电脑 -> 手机」（手机从电脑取文件）还是「手机 -> 电脑」。
    // × 的含义两个方向不一样：接收方向要弹「保留 / 不保留」再收尾，
    // 发送方向没有半截落盘文件可留，直接中断这一轮就行。
    // 不分方向的话，推送过程中点 × 会走到 cancel-recv，而 control::receiving()
    // 在发送时是 false，于是被当成「当前没有接收在进行」直接忽略 ——
    // 真机 2026-11-21 日志连打 20 行「取消接收被忽略」，用户看到的就是「按了不管用」。
    in-out property <bool> sending-now: false;
    // 取消的确认框（和主界面那套是同一个组件、同一套 Rust 处理函数）
    in-out property <bool> cancel-ask: false;
    // 这一轮已经受理过取消：把「取消」按钮收起来（同一轮只让取消一次）
    in-out property <bool> cancelling: false;

    callback toggle-pause();
    // 收起（标题栏 ✕ 也走它）：藏窗口，传输继续
    callback close-window();
    callback toggle-details();
    // 返回 false = 这次点击被忽略（没在接收 / 已经在取消中），别弹确认框
    callback cancel-recv() -> bool;
    // 发送方向同理：半截文件在手机上，也要问「保留 / 不保留」。
    // 返回 false = 这次点击被忽略（没在发送 / 已经在取消中），别弹确认框
    callback cancel-send() -> bool;
    callback cancel-keep();
    callback cancel-discard();
    callback cancel-dismiss();

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        // ---- 上半：上下文 + 进度条（左右 26px 内边距，照参考图量：条子 x=27、客户区 x=1）----
        // 原来是 24，比原生少 2px —— 用户说「文本位置太挤」，把这 2px 还给原生。
        VerticalLayout {
            padding-left: 26px;
            padding-right: 26px;
            spacing: 0px;

            Rectangle { height: 14px; }

            Text {
                text: root.action-text;
                font-size: 14px;
                // #000000 = 参考图主文案「正在将…」那一行的最暗像素（(46,50) 一带，纯黑），
                // 原来是 #1A1A1A（比原生浅一档）
                color: #000000;
                height: 20px;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle { height: 6px; }

            HorizontalLayout {
                height: 30px;
                spacing: 6px;

                Text {
                    // 精简：不再拼「已完成 / 未完成」前缀 —— 标题栏已经说明状态，
                    // 大号数字只报百分比
                    text: root.percent + "%";
                    font-size: 20px;
                    font-weight: 600;
                    // #000000 = 参考图「已完成 8%」大字的最暗像素（(28..120, 66..79) 里的纯黑）；
                    // 失败那一行的红 #C42B1C 没动（参考图里没有失败态可采，沿用现值）
                    color: root.failed ? #C42B1C : #000000;
                    vertical-alignment: center;
                }
                Text {
                    text: root.detail-text;
                    // #616161 = 沿用现值：参考图里没有次级灰字（正文全是黑的），
                    // 这已经是中性灰（R=G=B），不存在「太鲜艳」的问题
                    font-size: 12px;
                    color: #616161;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                // 暂停 / 继续：参考图右边那两颗方框按钮，鼠标移上去才有底色
                Rectangle {
                    width: root.paused ? 36px : 30px;
                    height: 28px;
                    border-radius: 4px;
                    background: pause-ta.has-hover ? #F0F0F0 : transparent;
                    visible: !root.done;

                    // 运行中画两条竖杠（字体里不一定有 ⏸，画出来最稳）
                    // #000000 = 参考图 ⏸ 图标 (355..385, 64..82) 的最暗像素（纯黑），原来是 #1A1A1A
                    Rectangle {
                        visible: !root.paused;
                        x: 10px;
                        y: 8px;
                        width: 3px;
                        height: 12px;
                        background: #000000;
                    }
                    Rectangle {
                        visible: !root.paused;
                        x: 17px;
                        y: 8px;
                        width: 3px;
                        height: 12px;
                        background: #000000;
                    }
                    Text {
                        visible: root.paused;
                        text: "继续";
                        font-size: 12px;
                        color: #000000;
                        width: 100%;
                        height: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    // 纯图标控件：UIA 里以前什么都列不出来（里面是 Rectangle，没有可访问名），
                    // 自动化和读屏都点不到/读不出。TouchArea 上加角色 + 名字，
                    // 名字跟着状态走（和可见的「继续」一致）。
                    pause-ta := TouchArea {
                        accessible-role: button;
                        accessible-label: root.paused ? "继续" : "暂停";  // 英文：Resume / Pause
                        clicked => { root.toggle-pause(); }
                    }
                }

                // 取消：参考图右边那颗 ✕，接的是「保留 / 不保留」那套流程
                Rectangle {
                    width: 30px;
                    height: 28px;
                    border-radius: 4px;
                    background: cancel-ta.has-hover ? #F0F0F0 : transparent;
                    // 失败时也要留着这颗 ✕：它是把「接收失败」这个窗口关掉的唯一按钮
                    visible: (!root.done || root.failed) && !root.cancelling;

                    Text {
                        // × 是 GB2312 里就有的乘号，✕(U+2715) 在 YaHei 里没有，会变豆腐块
                        text: "×";
                        font-size: 18px;
                        // #000000 = 参考图右上角 ✕ 图标 (409..416, 64..82) 的最暗像素，原来是 #1A1A1A
                        color: #000000;
                        width: 100%;
                        height: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    // 纯图标控件：UIA 里以前只暴露成一颗 Text「×」，没有按钮角色。
                    // 加角色 + 名字之后自动化能按「取消接收」点到它（读屏也读得出）。
                    cancel-ta := TouchArea {
                        accessible-role: button;
                        accessible-label: "取消接收";  // 英文：Cancel
                        clicked => {
                            // 失败那一轮：这颗 ✕ 变成「关掉这个失败提示」
                            // （已经没有传输在跑了，走取消流程只会被忽略，按钮就成死的了）
                            if (root.failed) {
                                root.close-window();
                            } else if (root.sending-now) {
                                // 电脑 -> 手机：半截文件写在手机那头，同样要问
                                // 「保留 / 不保留」—— 「不保留」由 CANCEL_DISCARD
                                // 让手机自己删掉（见 session.rs rebuild_transfers）。
                                if (root.cancel-send()) {
                                    root.cancel-ask = true;
                                }
                            } else if (root.cancel-recv()) {
                                // 手机 -> 电脑：先暂停（手机端跟着停发），再问保留不保留
                                root.cancel-ask = true;
                            }
                        }
                    }
                }
            }

            // ---- 失败原因那一行红字 ----
            // content-h / transfer_window_height() 里一直挂着「failed 时 +20px」，但布局里
            // 从某一轮精简起就没画过这行了 —— 失败时窗口底下会白白多出 20px。这轮补上，
            // 让它和那两个公式对得上（红色 #C42B1C = 失败态百分比大字的那个红）。
            if root.failed : Text {
                text: root.fail-text;
                font-size: 12px;
                color: #C42B1C;
                height: 20px;
                width: 100%;
                vertical-alignment: center;
                overflow: elide;
            }

            // ---- 分段进度条整块：展开「详细信息」时**不画**（用户拍板：「详细信息展开后，
            // 顶部那条分段进度条就不显示了，整窗只留详情里那条大聚合进度条」）----
            // 用 if 而不是 visible:false —— visible:false 仍然占着 13+15 的高度，展开后窗口
            // 顶上会横一条空白，那就是「底部留白」的另一种样子。
            if !root.details : VerticalLayout {
                spacing: 0px;

                // 百分比行到条 13px：参考图大字墨迹底 y=79、条顶 y=92，中间 13 行。原来是 12。
                Rectangle { height: 13px; }

                // 进度条：底是资源管理器那张参考图量出来的 —— 条高 15px、直角、1px #BCBCBC 描边、
                // 轨道 #E6E6E6、填充原生绿 #0F7B0F。
                //
                // 2026-11-19 复核（用户说「进度条配色太鲜艳」）：把参考图和本程序的截图逐点比过，
                // 三个色**一模一样**，所以这一项不改，只补出处：
                //   * 描边 #BCBCBC —— 参考图 (27,92) / (200,92) / (200,106)，条子上下各一行；
                //   * 轨道 #E6E6E6 —— 参考图 (200,93)（条内未填充区域）；
                //   * 填充 #0F7B0F —— 参考图 (200,97) / (30,93)（左边已填充那段）；
                //   本程序真机截图 xfer-window-details.png 里同位置取到的也是这三个值。
                // 最后一段 8% 的绿之所以显得艳，是「窄窄一条高饱和绿」的观感，颜色本身是原生色，
                // 改浅反而就不像资源管理器了。
                //
                // 填充规则：**分段，每段从自己的左边缘往右填**（用户定的）。
                // 每段就是某条（或某几条合并后的）通道负责的那段文件，段宽 ∝ 块数，
                // 填到哪儿 = 这段里已经落盘的块占多少。各段同时推进、跨过切分线互不影响；
                // 全部填满就是一条完整的绿杠。以前之所以看着像「从中间往两边涨」，
                // 不是这个画法的问题，是切分点算错了（未知归属在中间一分为二，见 §6.1c）。
                bar := Rectangle {
                    height: 15px;
                    background: #E6E6E6;
                    border-width: 1px;
                    border-color: #BCBCBC;
                    border-radius: 0px;
                    clip: true;

                    // 一截一块，各填各的（段宽 ∝ 这段占整条的比例）
                    for seg in root.segs : Rectangle {
                        x: 1px + (bar.width - 2px) * seg.x;
                        width: Math.max(0px, (bar.width - 2px) * seg.span);
                        height: bar.height - 2px;
                        background: transparent;
                        clip: true;

                        piece := Rectangle {
                            // x 必须显式写 0：不给 x 时 Slint 会把这个块**居中**摆进这一段，
                            // 于是每段的绿都从段中间往两边长 —— 真机上就是「进度条从中间往两边涨」
                            // （像素实测：段起点 33、段宽 68、绿的起点 64 ≈ 33 + (68-8)/2）。
                            x: 0px;
                            width: parent.width * Math.max(0.0, Math.min(1.0, seg.filled));
                            height: 100%;
                            // 暂停 → 深琥珀 #9D5D00（参考图 native-paused.png 整条 (200,97) 都是它；
                            // 这一轮补上：以前暂停时条子还是绿的，和原生的「暂停色」差着一档）
                            background: root.paused ? #9D5D00 : #0F7B0F;
                            clip: true;

                            // 流光：**一道光扫整条**，不是每截各扫各的。
                            // 亮带位置用整条坐标算，各截只把经过自己的那段露出来（clip），
                            // 所以光从左边一路走到右边，跨切分线时是连续的。
                            // 参数照抄 Windows 原生（WPF 默认模板的 PART_GlowRect），不是随手调的：
                            //   带宽 100px；水平渐变 #00FFFFFF 0% → #60FFFFFF 40% → #60FFFFFF 60% →
                            //   #00FFFFFF 100%（0x60 = 37.6% 白，中段 40% 实心、两侧各 30% 羽化）；
                            //   匀速 200 px/s 从左边外面扫到填充区右边外面，扫完停 1 秒再从头来。
                            // 出处：dotnet/wpf Themes/XAML/ProgressBar.xaml + ProgressBar.cs 的 UpdateAnimation。
                            band := Rectangle {
                                visible: root.flow-on && piece.width > 8px;
                                private property <length> band-w: 100px;
                                x: (bar.width - 2px) * root.flow - (bar.width - 2px) * seg.x - band.band-w / 2;
                                y: 0px;
                                width: band.band-w;
                                height: 100%;
                                // 注意 Slint 的颜色是 #RRGGBBAA（最后两位是透明度）
                                background: @linear-gradient(90deg,
                                    #FFFFFF00 0%,
                                    #FFFFFF60 40%,
                                    #FFFFFF60 60%,
                                    #FFFFFF00 100%);
                            }
                        }
                    }

                    // 切分线画在最上面：灰底和绿底上都看得见，一条通道一截全靠它分
                    for seg in root.segs : Rectangle {
                        visible: seg.x > 0.0001;
                        x: 1px + (bar.width - 2px) * seg.x;
                        width: 1px;
                        height: bar.height - 2px;
                        background: #F2F2F2;
                    }
                }
            }
        }

        // ---- 条到分隔线 15px（参考图条底 y=106、线 y=122，中间 15 行纯白）----
        // 这一段以前是 **0**：线直接贴着条子画，看着像进度条自己的第二道边，
        // 用户说的「分界线太明显」主要就是这个。加上原生那 15px 之后，线才回到
        // 「段落分隔」的位置上。
        // 展开态这一块整段被 if 掉了（见上面），这里换成 13px：条子不画了，但百分比行和
        // 分隔线之间还得留一口气，否则那条线会贴到 20px 大字的脚上（content-h 里记的就是 13）。
        if root.details : Rectangle { height: 13px; }
        if !root.details : Rectangle { height: 15px; }

        // ---- 分隔线：贯穿整窗（参考图就是整窗宽，不带内边距）----
        // #E3E3E3 = 参考图 (10,122)/(200,122)/(440,122)，整行 447 个像素全是这个值。
        // 颜色本来就是对的（不是深灰），扎眼是上面那个 0 间距造成的，所以这里只保留原色。
        Rectangle { height: 1px; background: #E3E3E3; }

        // ---- 下半：详情（展开时）+「详细信息 / 简略信息」开关行 ----
        // 顺序照原生 native-details.png：分隔线 → 名称 / 剩余时间 / 剩余项目 → 大聚合条
        // → 各通道速率 → 分隔线 → 「∧ 简略信息」。所以**开关行在展开时位于最底下**，
        // 收起时它正好紧跟在分隔线后面（位置和改之前一模一样）。
        // 和上半一样 26px 内边距：参考图里箭头墨迹从 x=31 起、正文从 x=27 起。
        VerticalLayout {
            padding-left: 26px;
            padding-right: 26px;
            spacing: 0px;

            if root.details : VerticalLayout {
                spacing: 0px;

                // 分隔线 → 「名称：」第一行 10px（和收起态「线到开关行」同一个 10）。
                Rectangle { height: 10px; }

                // ---- 三行「标签：值」----
                // 量测（native-details.png）：三行墨迹 y=185..197 / 202..213 / 221..232，
                // 行距 17、19（取整 18），字号 12px（「剩余项目：」5 个字 60px 宽 = 12px/字），
                // 左边距和正文同一条线（ink 从 x=27 起 = 26px 内边距 + 1px 字形左留白）。
                // 颜色全部 #000000：在 (27..60,185..197) 里取最暗像素是纯黑；图上那些偏橙
                // /偏蓝的点是 ClearType 的次像素边，不是字色。
                // 值由 Rust 每帧喂（file-name / eta-text / remain-text），标签固定在这边。
                Text {
                    text: "名称：" + root.file-name;
                    font-size: 12px;
                    color: #000000;
                    height: 18px;
                    width: 100%;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    // 算不出来时 Rust 传「正在计算...」（原生的写法就是这个）
                    text: "剩余时间：" + root.eta-text;
                    font-size: 12px;
                    color: #000000;
                    height: 18px;
                    width: 100%;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: "剩余项目：" + root.remain-text;
                    font-size: 12px;
                    color: #000000;
                    height: 18px;
                    width: 100%;
                    vertical-alignment: center;
                    overflow: elide;
                }

                // 三行到大条子 8px
                Rectangle { height: 8px; }

                // ---- 速度图表条（原生「详细信息」里那块 79/80px 的图表）----
                // 这一块和收起态那条分段条是**互斥的两套**：分段条（IDM 式一段一通道 + 白色流光）
                // 只在收起时画，展开时整块被 if 掉；这里只有图表条，不再有任何分段竖线、也没有流光。
                //
                // 参考图 native-details.png 逐行量出来的结构（坐标都相对条子左上角）：
                //   y=0        #BCBCBC 外框 1px
                //   y=1        #E6E6E6 内侧 1px
                //   y=2..49    #A7E591 上层（48px）：竖网格 #8EDD7B 间距 39（首个在 x=38）、
                //              横网格 #8EDD7B 在 y=15 / 30 / 46；已完成区间里叠 #06B025 的速度曲线面积
                //   y=50       #000000 黑基线 1px（横贯整条，不随进度）
                //   y=51..77   #06B025 下层实心（整条宽度都是，不随进度 —— 原生就是这样）
                //   y=78       #E6E6E6 内侧 1px
                //   y=79       #BCBCBC 外框 1px
                // 合计 80px。参考图里能数出 79 是因为只数到 y=78 那条内侧线；
                // 但 y=79 那条 #BCBCBC 也是这条子的一部分（下面 y=80 就是纯白），所以这里按 80 做。
                //
                // 「速度: 72.9 MB/秒」那行黑字叠在上层里、基线之上、靠右（参考图墨迹 x=319..414、
                // y=126..137，相对本条 = x 右缩 2px、y 32..43）。
                chart := Rectangle {
                    height: 80px;
                    // 外框用「底色 + 内嵌两块」画，不用 border-width —— 后者对子元素的坐标系
                    // 是内缩还是原点是 Slint 的实现细节，直接摆坐标最稳。
                    background: #BCBCBC;
                    clip: true;

                    // 内侧 1px #E6E6E6（顶和底；左右两边也被这一层盖住）
                    Rectangle {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                        background: #E6E6E6;
                    }

                    // ---- 图表主体 76px（贴完原生实测的 463x302 复制对话框）----
                    //
                    // 原生的图表是**两个区域**，不是一整块浅绿：
                    //   已完成区（0 .. 进度）：底 #A7E591、网格 #8EDD7B
                    //   未完成区（进度 .. 右）：底 #FFFFFF、网格 #CDEFD3（= #06B025 20% 叠白）
                    // 深绿面积 #06B025 **只出现在已完成区**，上沿是速度曲线、下沿是主体底沿。
                    // 「黑线以下一开始就填满」就是因为以前把面积画成整条宽度了。
                    //
                    // 网格是 10 列 × 5 行：竖线 i×W/10（i=1..9），横线 i×76/5 = 15/30/46/61。
                    // 这个 10×5 和开源实现 rhengles/transfer-speed-graph 的 gridCols/gridRows 一致，
                    // 也和我们逐像素量的竖线位置（38,77,117,157…）完全对得上。
                    body := Rectangle {
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: 76px;
                        background: #FFFFFF;
                        clip: true;

                        // ---- 已完成区：浅绿底 ----
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: body.width * root.fill;
                            height: 100%;
                            background: #A7E591;
                        }

                        // ---- 已完成区：网格 + 速度面积（整块裁到已完成区间）----
                        done-zone := Rectangle {
                            x: 0px;
                            y: 0px;
                            width: body.width * root.fill;
                            height: 76px;
                            clip: true;

                            for i in 9 : Rectangle {
                                x: body.width * (i + 1) / 10;
                                y: 0px;
                                width: 1px;
                                height: 100%;
                                background: #8EDD7B;
                            }
                            Rectangle { x: 0px; y: 15px; width: 100%; height: 1px; background: #8EDD7B; }
                            Rectangle { x: 0px; y: 30px; width: 100%; height: 1px; background: #8EDD7B; }
                            Rectangle { x: 0px; y: 46px; width: 100%; height: 1px; background: #8EDD7B; }
                            Rectangle { x: 0px; y: 61px; width: 100%; height: 1px; background: #8EDD7B; }

                            // 面积画在网格之上（原生曲线区内网格是被盖住的）
                            // fit 必须写 fill（= 拉伸）：Path 默认的 contain 会「等比缩放 + 居中」，
                            // viewbox 1000x76 塞进 403x76 时纵向只剩 76*0.403≈31px 还居中。
                            curve := Path {
                                x: 0px;
                                y: 0px;
                                width: body.width;
                                height: 76px;
                                fit: ImageFit.fill;
                                viewbox-x: 0;
                                viewbox-y: 0;
                                viewbox-width: 1000;
                                viewbox-height: 76;
                                commands: root.curve-path;
                                // 暂停 → 面积换琥珀 #9D5D00（网格、黑线不变）
                                fill: root.paused ? #9D5D00 : #06B025;
                            }
                        }

                        // ---- 未完成区：只有浅网格，没有面积 ----
                        undone-zone := Rectangle {
                            x: body.width * root.fill;
                            y: 0px;
                            width: body.width - body.width * root.fill;
                            height: 76px;
                            clip: true;

                            // 网格坐标还是按整条算，只是被这个容器裁掉左半截 ——
                            // 所以这里减去已完成宽度，线才能落在和已完成区同一条 x 上。
                            for i in 9 : Rectangle {
                                x: body.width * (i + 1) / 10 - body.width * root.fill;
                                y: 0px;
                                width: 1px;
                                height: 100%;
                                background: #CDEFD3;
                                visible: (body.width * (i + 1) / 10) > (body.width * root.fill);
                            }
                            Rectangle { x: 0px; y: 15px; width: 100%; height: 1px; background: #CDEFD3; }
                            Rectangle { x: 0px; y: 30px; width: 100%; height: 1px; background: #CDEFD3; }
                            Rectangle { x: 0px; y: 46px; width: 100%; height: 1px; background: #CDEFD3; }
                            Rectangle { x: 0px; y: 61px; width: 100%; height: 1px; background: #CDEFD3; }
                        }

                        // ---- 黑线：整条横贯（未完成区里也有），压在其它所有东西之上 ----
                        // y 由 Rust 按「当前速度 / 量程」算出来，每帧都可能不同 ——
                        // 原生实测 25 帧 y 在 7..40（相对主体）之间来回跳，速度越快线越高。
                        Rectangle {
                            x: 0px;
                            y: root.guide-y * 1px;
                            width: 100%;
                            height: 1px;
                            background: #000000;
                        }

                        // ---- 「速度: xx MB/秒」：底边恒在黑线上方 6px，靠右留 6px ----
                        // 它跟着黑线走（原生 4 帧实测都是 6px 间距），所以不是固定标签。
                        Text {
                            text: root.speed-text;
                            font-size: 12px;
                            color: #000000;
                            x: 0px;
                            // 字底 = 黑线上方 6px（原生 4 帧实测都是 6px）：
                            // 12px 字在 18px 高的盒子里垂直居中，盒子底 = y + 18，
                            // 要让盒子底落在 guide-6，就是 y = guide - 24。
                            y: (root.guide-y * 1px) - 24px;
                            width: parent.width - 6px;
                            height: 18px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // 大条子到各通道速率第一行 8px
                Rectangle { height: 8px; }

                // ---- 各通道速率：每条通道一行 ----
                // 通道名和手机端明细那张表同名（USB_ADB / wlan0#4），两边的读法一致。
                // 四列：序号+通道名 110 / 已收·该段总量 / 速率 78（右对齐）/ 完成度 44（右对齐）。
                // 速率列这一轮提到黑字（它是这一块的主角），完成度留在 #616161。
                // 行高 22px（Windows 列表的标准行高），12px 字。
                for row in root.rows : HorizontalLayout {
                    height: 22px;
                    spacing: 14px;

                    Text {
                        text: row.name;
                        font-size: 12px;
                        color: #000000;
                        width: 110px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: row.amount;
                        font-size: 12px;
                        color: #000000;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        // 「9.2 MB/s」/「已完成」/「0 KB/s」（Rust 那边按状态给）
                        text: row.rate;
                        font-size: 12px;
                        color: #000000;
                        width: 78px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: row.percent + "%";
                        font-size: 12px;
                        // #616161 = 次级灰（和收起态 detail-text 同一个灰，中性、不艳）
                        color: #616161;
                        width: 44px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }

                if root.rows.length == 0 : Text {
                    text: "这一轮还没有分通道数据";
                    font-size: 12px;
                    color: #8A8A8A;
                    height: 22px;
                    vertical-alignment: center;
                }
            }

            // 详情最后一行（或收起态的分隔线）到开关行 10px。
            // 收起态：参考图线 y=122、行框 133..155，所以「线到行框 10px」=「线到文字 15px」。
            if root.details : Rectangle { height: 10px; }
            // 展开态在「简略信息」上面**还有一条分隔线**：参考图 native-details.png 的 x=5 一列
            // 从客户区顶到窗底只有 y=250 这一行是 #E3E3E3，位置正好在「∧ 简略信息」上面
            // （y=250 线 → 文字墨迹 266..278）。收起态那条线（y=122）在这个位置之外，
            // 所以这里是展开态独有的 1px。content-h / transfer_window_height() 里记成 +1。
            if root.details : Rectangle { height: 1px; background: #E3E3E3; }
            Rectangle { height: 10px; }

            // ---- 开关行（整行可点，和资源管理器一样，不用非得点到字上）----
            // 行高 22px = Windows 列表的标准行高；12px 字 = 参考图「详细信息」4 个字 48px。
            Rectangle {
                height: 22px;
                // 悬浮时**不刷底色**（用户 2026-11-19：「鼠标悬浮停留时这个详细信息阴影删除，
                // 或者 1:1 仿原生」）。原生这一行确实有 hover 高亮，但整行 460px 刷成 #F5F5F5
                // 之后，白底窗口里横着一条灰带，比原生那张图里任何一处都显眼。宁可没有。
                background: transparent;

                // ---- 箭头：V 形，用 Path 画（不再用 ▼/▲ 字形）----
                // 量测（native-paused.png）：箭头墨迹 x=31..41（11px 宽）、y=141..147（7px 高），
                // 最暗 #1F1F1F（12px 细笔画抗锯齿后还是黑），像 1px 圆头的两笔斜线；
                // 行框是 y=133..155（22px），墨迹上下各留 8px → 7px 高摆在 y=7 正好居中。
                // 左边：26px 内边距 + 4px = 30，ink 从 31 起（形状自己留 1px）；
                // 文字 ink 从 51 起 → 文字框 x=24（26+24=50，字形自带 1px 左留白）。
                chevron := Path {
                    // 左边距：26px 内边距 + 3px = 29，描边圆头再吃掉 0.5 → 墨迹从 30 起
                    // （参考图墨迹 31..41，客户区从 1 起 → 相对正文线 3..13）
                    x: 3px;
                    // 纵向：参考图箭头墨迹 x=31..41 / y=142..146（11 宽、5 高、1px 圆头细线），
                    // 行框 133..155 → 墨迹在 +9..+13。这里元素 12x6、笔画 0.5..5，
                    // 描边圆头再各探出 0.5 → 实墨 +8..+13，和参考图差半像素以内。
                    y: 8px;
                    width: 12px;
                    height: 6px;
                    // viewbox 和元素尺寸一样大 → 缩放正好 1:1，描边不会被缩放拉粗拉细
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 12;
                    viewbox-height: 6;
                    // 收起 = ∨（尖朝下，笔尖在 y 大的那边）—— 参考图 native-paused.png 就是这个；
                    // 展开 = ∧（尖朝上）。圆头（stroke-line-cap: round）和参考图的细笔画一致。
                    commands: root.details
                        ? "M 1 5 L 6 0.5 L 11 5"
                        : "M 1 0.5 L 6 5 L 11 0.5";
                    stroke: #1F1F1F;
                    stroke-width: 1px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                }

                Text {
                    // 文字跟着原生走：收起「详细信息」/ 展开「简略信息」
                    // （▼/▲/✕ 这类符号会缺字形或宽窄不一，图标一律 Path 画）
                    x: 24px;
                    text: root.details ? "简略信息" : "详细信息";
                    font-size: 12px;
                    color: #000000;
                    height: 100%;
                    vertical-alignment: center;
                }
                // 整行一个按钮：UIA 里以前只是一颗 Text，自动化点不到。
                // 名字跟可见文字同步（收起「详细信息」/ 展开「简略信息」），两个状态下都能点。
                details-ta := TouchArea {
                    accessible-role: button;
                    accessible-label: root.details ? "简略信息" : "详细信息";  // 英文：Hide/Show details
                    clicked => { root.toggle-details(); }
                }
            }

            Rectangle { height: 10px; }

            // 取消确认框不再画在这里：它现在是**独立窗口**（见文件开头的 CancelAskWindow）。
            // 这里只留 cancel-ask 这个状态位，Rust 每帧读它，翻成 true 就把那个窗口弹出来。
            // 以前是遮罩层，得靠「加 65px 占位」把窗口物理撑高才露得全（§6.2），独立窗口不用。
        }
    }
}

// ---------------------------------------------------------------------------
// 「发送到手机」小窗（PushWindow）
//
// 右键「发送到 → 手机」推过来文件时，以前会把整套接收器主界面弹出来，
// 再靠里面那张「选择接收设备」卡片等你去点 —— 用户的要求：**推送不要跳转到接收器界面**。
// 所以这里是**独立窗口**，只有三屏，不碰主界面（gui_slint.rs 的推送路径里
// ui.show() / show_main_window 一律不调用；主界面那张卡片保留给「从主界面里主动发」）。
//
// 同一个窗口换内容 = 三步走状态机（Rust 那边 PushRound 驱动）：
//   step 0  发送到哪台：设备列表，每台一行（整行可点，右边一颗「发送」）+ 取消
//   step 1  正在发送：目标 / 文件名 / 进度条 + 百分比 + 速率 + 取消发送
//   step 2  已发送（failed=true 时是失败：红字写原因，不自动关）
// 单台设备时 Rust 直接把 step 置成 1（不用用户点）；多台必须让用户点。
//
// 尺寸：宽 420 给死；高度按屏算（content-h → preferred-height，逐项在下面注明）。
// 落位（工作区右下角）/ 置顶 / 抢前台都在 gui_slint.rs（和传输窗口同一套做法）。
//
// 窗口标题故意**固定**成「发送到手机」：gui 靠标题找 hwnd 来贴右下角 + 置顶，
// 标题跟着状态变就会有一帧找不到窗口（TransferWindow 那边踩过这个坑，见 tray_win.rs），
// 所以状态全部表达在窗口内容里。
//
// 配色沿用传输窗口那套：底 #FFFFFF、分隔线 #E3E3E3、正文 #000000、次级 #616161、
// 进度条 轨道 #E6E6E6 / 填充 #0F7B0F / 描边 #BCBCBC。字号一律整数 px；
// 图标（手机 / 勾）一律 Path 画 —— ✕ ✓ 这类字形在 YaHei 里不一定有。
// ---------------------------------------------------------------------------
export struct PushDevice {
    // 设备真名（Xiaomi Pad 7 Pro）；名字还没解析出来时是序列号前 8 位
    name: string,
    // 圆形头像里那个字（名字首字母）
    avatar: string,
    // 「已连接 · 10 条通道」/「正在连接…」/「连不上 · 重试中」
    status: string,
    // 多选：这一行打没打勾（点整行切换）
    selected: bool,
}

// 小窗里的「文字按钮」：无底无边，hover 才出浅灰 #F0F0F0（Win11 内容对话框里的链接按钮）
component PushTextButton inherits Rectangle {
    in property <string> label;
    callback clicked;

    width: 60px;
    height: 32px;
    border-radius: 4px;
    background: ta.has-hover ? #F0F0F0 : transparent;

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: #000000;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // 纯文字按钮也必须能被 UIA 找到（测试脚本按名字点）
    ta := TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.clicked(); }
    }
}

// 手机图标：竖长圆角框 + 底部一条听筒线，Path 画（不用 emoji / 字体符号）
component PhoneGlyph inherits Rectangle {
    in property <color> tint: #1F1F1F;

    width: 20px;
    height: 26px;
    background: transparent;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 20;
        viewbox-height: 26;
        commands: "M 5 1 C 3.3 1 2 2.3 2 4 L 2 22 C 2 23.7 3.3 25 5 25 L 15 25 C 16.7 25 18 23.7 18 22 L 18 4 C 18 2.3 16.7 1 15 1 Z M 8 21 L 12 21";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.6px;
        stroke-line-cap: round;
    }
}

// 成功那个勾：Path 画（✓ U+2713 在 YaHei 里没有，会变豆腐块）
component CheckGlyph inherits Rectangle {
    in property <color> tint: #0F7B0F;

    width: 20px;
    height: 20px;
    background: transparent;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: "M 3 10 L 8 15 L 17 5";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

export component PushWindow inherits Window {
    title: "发送到手机";
    default-font-family: "Segoe UI, Microsoft YaHei UI";
    default-font-size: 13px;
    preferred-width: 420px;
    background: #FFFFFF;

    // 0 = 选设备 / 1 = 发送中 / 2 = 已发送（failed 时为失败）
    in-out property <int> step: 0;
    // 标题下那行「3 个文件 · 128.4 MB」
    in-out property <string> summary-text: "";
    in-out property <[PushDevice]> devices: [];
    in-out property <string> target-name: "";
    in-out property <string> file-name: "";
    // 「42%」
    in-out property <string> percent-text: "";
    // 「12.3 MB / 128.4 MB · 9.6 MB/s」
    in-out property <string> progress-text: "";
    in-out property <float> fill: 0.0;
    // 流光位置（0..1），Rust 那边 16ms 一拍推着走（和传输窗口同一条公式）
    in-out property <float> flow: 0.0;
    // 拿不到总进度（队列里量不出字节数 / 手机还没报）→ 不确定态：整条绿 + 跑光带
    in-out property <bool> indeterminate: false;
    in-out property <bool> failed: false;
    in-out property <string> fail-text: "";

    // 多选：打了几台（0 的时候「发送到选中的 N 台」是灰的）
    in-out property <int> chosen-count: 0;
    // 那颗主按钮上的字（0 台 = 「选择要发送的手机」，否则「发送到选中的 N 台」）
    in-out property <string> send-label: "选择要发送的手机";

    // 第 1 屏：用户点了第 i 台右侧那颗「发送」（只发这一台）
    callback choose(int);
    // 第 1 屏：点了第 i 行的勾 / 整行（切换这一行的勾选）
    callback toggle(int);
    // 第 1 屏：点「发送到选中的 N 台」
    callback send-selected();
    // 第 1 屏「取消」/ 第 3 屏「关闭」：收窗口，队列不动
    callback cancel();
    // 设备列表为空时那颗「重试」
    callback retry();
    // 第 2 屏「取消发送」：中断这次发送
    callback cancel-send();

    // ---- 高度：每块都是写死的高度，所以这里能把总量算准 ----
    // step 0: 14(上留白) + 40(标题行) + 12 + 1(分隔线) + 6 + 列表 + 8 + 32(按钮行) + 12 = 125 + 列表
    //         列表 = 设备数*56；一台都没有时 76（两行说明 + 「重试」）
    // step 1: 16 + 40 + 12 + 1 + 14 + 20(文件名) + 8 + 15(进度条) + 10 + 20(百分比行) + 14 + 32 + 12 = 214
    // step 2: 16 + 40 + 12 + 1 + 14 + 12 = 95；失败再 +20(红字) +8 +32(关闭按钮) = 155
    private property <length> list-h: root.devices.length == 0 ? 76px : root.devices.length * 56px;
    private property <length> content-h: root.step == 0
        ? 125px + root.list-h
        : (root.step == 1 ? 214px : (95px + (root.failed ? 60px : 0px)));
    preferred-height: root.content-h;

    Rectangle {
        width: 100%;
        height: 100%;
        background: #FFFFFF;

        VerticalLayout {
            spacing: 0px;
            padding-left: 16px;
            padding-right: 16px;

            // ================= 第 1 屏：发送到哪台 =================
            if root.step == 0 : VerticalLayout {
                spacing: 0px;

                Rectangle { height: 14px; }

                // 标题行 40px：手机图标（26 高，居中 y=7）+ 主文案 + 副文案
                Rectangle {
                    height: 40px;
                    background: transparent;

                    PhoneGlyph { x: 0px; y: 7px; }
                    Text {
                        x: 32px;
                        y: 0px;
                        width: parent.width - 32px;
                        height: 22px;
                        text: "发送到手机";
                        font-size: 15px;
                        font-weight: 600;
                        color: #000000;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        x: 32px;
                        y: 20px;
                        width: parent.width - 32px;
                        height: 18px;
                        text: root.summary-text;
                        font-size: 12px;
                        color: #616161;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle { height: 12px; }
                Rectangle { height: 1px; background: #E3E3E3; }
                Rectangle { height: 6px; }

                // ---- 设备列表：每台一行 56px ----
                for d[i] in root.devices : Rectangle {
                    height: 56px;
                    // hover 时整行浅灰；点「发送」那颗也算在整行里（同一块高亮）
                    background: (row-ta.has-hover || send-ta.has-hover) ? #F5F5F5 : transparent;

                    // 勾选框（18x18，圆角 3）：Path 画勾，不用 ✓ 字形
                    Rectangle {
                        x: 0px;
                        y: 19px;
                        width: 18px;
                        height: 18px;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: d.selected ? #0F7B0F : #C6C6C6;
                        background: d.selected ? #0F7B0F : #FFFFFF;

                        if d.selected : CheckGlyph {
                            x: 3px;
                            y: 3px;
                            width: 12px;
                            height: 12px;
                            tint: #FFFFFF;
                        }
                    }

                    // 圆形头像：名字首字母
                    Rectangle {
                        x: 30px;
                        y: 12px;
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: #EFEFEF;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: d.avatar;
                            font-size: 14px;
                            font-weight: 600;
                            color: #4A4A4A;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // 上行 = 设备真名
                    Text {
                        x: 74px;
                        y: 10px;
                        width: parent.width - 162px;
                        height: 20px;
                        text: d.name;
                        font-size: 14px;
                        color: #000000;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // 下行 = 状态（灰 12px）
                    Text {
                        x: 74px;
                        y: 30px;
                        width: parent.width - 162px;
                        height: 16px;
                        text: d.status;
                        font-size: 12px;
                        color: #616161;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // 右侧那颗「发送」小按钮（画出来的样子）
                    Rectangle {
                        x: parent.width - 76px;
                        y: 13px;
                        width: 76px;
                        height: 30px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #D7D7D7;
                        background: send-ta.has-hover ? #F0F0F0 : #FFFFFF;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "发送";
                            font-size: 12px;
                            color: #000000;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // 整行可点 = 切换勾选（读屏/自动化按设备名找得到）；「发送」那颗叠在它上面
                    row-ta := TouchArea {
                        accessible-role: button;
                        accessible-label: d.name;
                        clicked => { root.toggle(i); }
                    }
                    send-ta := TouchArea {
                        x: parent.width - 76px;
                        width: 76px;
                        accessible-role: button;
                        accessible-label: "发送";
                        clicked => { root.choose(i); }
                    }
                }

                // ---- 一台设备都没有：说清楚该怎么办，给一颗「重试」----
                if root.devices.length == 0 : Rectangle {
                    height: 76px;
                    background: transparent;

                    Text {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 44px;
                        text: "还没有手机连接，插上数据线或连同一个 Wi-Fi 就自动出现";
                        font-size: 12px;
                        color: #616161;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                    PushTextButton {
                        x: 0px;
                        y: 44px;
                        width: 56px;
                        label: "重试";
                        clicked => { root.retry(); }
                    }
                }

                Rectangle { height: 8px; }

                // 底部：左「发送到选中的 N 台」（一台都没勾时是灰的）+ 右「取消」
                Rectangle {
                    height: 32px;
                    background: transparent;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 148px;
                        height: 32px;
                        border-radius: 4px;
                        background: root.chosen-count > 0
                            ? (send-all-ta.has-hover ? #0E6E0E : #0F7B0F)
                            : #EDEDED;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: root.send-label;
                            font-size: 12px;
                            color: root.chosen-count > 0 ? #FFFFFF : #9A9A9A;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        send-all-ta := TouchArea {
                            accessible-role: button;
                            accessible-label: root.send-label;
                            clicked => {
                                if (root.chosen-count > 0) {
                                    root.send-selected();
                                }
                            }
                        }
                    }

                    PushTextButton {
                        x: parent.width - 60px;
                        y: 0px;
                        width: 60px;
                        label: "取消";
                        clicked => { root.cancel(); }
                    }
                }

                Rectangle { height: 12px; }
            }

            // ================= 第 2 屏：正在发送 =================
            if root.step == 1 : VerticalLayout {
                spacing: 0px;

                Rectangle { height: 16px; }

                Rectangle {
                    height: 40px;
                    background: transparent;

                    PhoneGlyph { x: 0px; y: 7px; }
                    Text {
                        x: 32px;
                        y: 0px;
                        width: parent.width - 32px;
                        height: 22px;
                        text: "正在发送到 " + root.target-name;
                        font-size: 15px;
                        font-weight: 600;
                        color: #000000;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        x: 32px;
                        y: 20px;
                        width: parent.width - 32px;
                        height: 18px;
                        text: root.summary-text;
                        font-size: 12px;
                        color: #616161;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle { height: 12px; }
                Rectangle { height: 1px; background: #E3E3E3; }
                Rectangle { height: 14px; }

                // 当前文件名（多文件时 Rust 那边拼「xxx（第 1 / 3 个文件）」）
                Text {
                    height: 20px;
                    text: root.file-name;
                    font-size: 13px;
                    color: #000000;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle { height: 8px; }

                // 进度条：和传输窗口那条一样 —— 15 高、直角、1px #BCBCBC 描边、
                // 轨道 #E6E6E6、填充 #0F7B0F、流光 100px 宽的光带（WPF 的 GlowRect 就是 100px）
                bar := Rectangle {
                    height: 15px;
                    background: #E6E6E6;
                    border-width: 1px;
                    border-color: #BCBCBC;
                    border-radius: 0px;
                    clip: true;

                    piece := Rectangle {
                        x: 1px;
                        y: 1px;
                        // 有 x 必须显式给：不给 x 时 Slint 会把填充块**居中**摆（真机上就是
                        // 「进度从中间往两边涨」，传输窗口那边已经踩过一次）
                        width: Math.max(0px, (bar.width - 2px) * Math.max(0.0, Math.min(1.0, root.fill)));
                        height: bar.height - 2px;
                        background: #0F7B0F;
                        clip: true;

                        // 流光：亮带位置用整条坐标算，被这一段 clip 住
                        Rectangle {
                            x: (bar.width - 2px) * root.flow - 50px;
                            y: 0px;
                            width: 100px;
                            height: 100%;
                            background: @linear-gradient(90deg,
                                #FFFFFF00 0%,
                                #FFFFFF60 40%,
                                #FFFFFF60 60%,
                                #FFFFFF00 100%);
                        }
                    }

                    // 不确定态：整条填满绿 + 光带整条跑（没有总进度时用）
                    if root.indeterminate : Rectangle {
                        x: 1px;
                        y: 1px;
                        width: bar.width - 2px;
                        height: bar.height - 2px;
                        background: #0F7B0F;
                        clip: true;

                        Rectangle {
                            x: (bar.width - 2px) * root.flow - 50px;
                            y: 0px;
                            width: 100px;
                            height: 100%;
                            background: @linear-gradient(90deg,
                                #FFFFFF00 0%,
                                #FFFFFF60 40%,
                                #FFFFFF60 60%,
                                #FFFFFF00 100%);
                        }
                    }
                }

                Rectangle { height: 10px; }

                // 百分比 + 「已发 / 总量 · 速率」
                Rectangle {
                    height: 20px;
                    background: transparent;

                    Text {
                        x: 0px;
                        y: 0px;
                        height: 20px;
                        text: root.percent-text;
                        font-size: 15px;
                        font-weight: 600;
                        color: #000000;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 52px;
                        y: 0px;
                        width: parent.width - 52px;
                        height: 20px;
                        text: root.progress-text;
                        font-size: 12px;
                        color: #616161;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle { height: 14px; }

                Rectangle {
                    height: 32px;
                    background: transparent;

                    PushTextButton {
                        x: parent.width - 76px;
                        y: 0px;
                        width: 76px;
                        label: "取消发送";
                        clicked => { root.cancel-send(); }
                    }
                }

                Rectangle { height: 12px; }
            }

            // ================= 第 3 屏：已发送 / 发送失败 =================
            if root.step == 2 : VerticalLayout {
                spacing: 0px;

                Rectangle { height: 16px; }

                Rectangle {
                    height: 40px;
                    background: transparent;

                    // 成功画勾（20 高，居中 y=10）；失败画个红色的手机
                    if root.failed : PhoneGlyph { x: 0px; y: 7px; tint: #C42B1C; }
                    if !root.failed : CheckGlyph { x: 0px; y: 10px; }
                    Text {
                        x: 32px;
                        y: 0px;
                        width: parent.width - 32px;
                        height: 22px;
                        text: root.failed ? "发送失败" : ("已发送到 " + root.target-name);
                        font-size: 15px;
                        font-weight: 600;
                        color: root.failed ? #C42B1C : #000000;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        x: 32px;
                        y: 20px;
                        width: parent.width - 32px;
                        height: 18px;
                        text: root.summary-text;
                        font-size: 12px;
                        color: #616161;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle { height: 12px; }
                Rectangle { height: 1px; background: #E3E3E3; }
                Rectangle { height: 14px; }

                // 失败原因（红字，只有失败才有；失败不自动关窗，等用户看完点「关闭」）
                if root.failed : Rectangle {
                    height: 20px;
                    background: transparent;

                    Text {
                        width: 100%;
                        height: 20px;
                        text: root.fail-text;
                        font-size: 12px;
                        color: #C42B1C;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.failed : Rectangle { height: 8px; }
                if root.failed : Rectangle {
                    height: 32px;
                    background: transparent;

                    PushTextButton {
                        x: parent.width - 60px;
                        y: 0px;
                        width: 60px;
                        label: "关闭";
                        clicked => { root.cancel(); }
                    }
                }

                Rectangle { height: 12px; }
            }
        }
    }
}
