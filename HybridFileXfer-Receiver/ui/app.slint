// 多轨快传 · 电脑接收器（Slint / fluent 样式）
// 配色只用一套：灰白表面 + 单一强调色（Windows 蓝），绿色仅用于 logo 与"已连接"状态点
import { Button, LineEdit, CheckBox, ComboBox, TextEdit } from "std-widgets.slint";

component Card inherits Rectangle {
    background: #FFFFFF;
    border-radius: 10px;
    border-width: 1px;
    border-color: #E5E5E5;
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #10182810;
}

component Divider inherits Rectangle {
    height: 1px;
    background: #EDEDED;
}

// 主按钮：Win11 强调色，14px 半粗
component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 116px;
    height: 34px;
    border-radius: 4px;
    background: !enabled ? #E6E9ED : (ta.has-hover ? #1A6FC4 : #005FB8);

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: enabled ? #FFFFFF : #9AA4AE;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component SecondaryButton inherits Rectangle {
    in property <string> label;
    callback clicked;

    width: 100px;
    height: 34px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #D7D7D7;
    background: ta.has-hover ? #F5F5F5 : #FFFFFF;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: #1A1A1A;
        font-size: 14px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "多轨快传 · 电脑接收器";
    icon: @image-url("logo-mark.png");
    // 中文必须显式指定字体族：默认字体的 CJK 回退常缺半粗体，600 会被合成为"假粗体"发糊
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;

    preferred-width: 900px;
    preferred-height: 820px;
    min-width: 760px;
    min-height: 620px;
    background: #F3F3F3;

    in property <string> app-version: "1.2.0";

    in-out property <string> status-title: "未开始接收";
    in-out property <string> status-sub: "点「开始接收」等待手机连接";
    in-out property <int> status-kind: 0;   // 0 停止 / 1 等待 / 2 已连接 / 3 重试中
    in-out property <bool> running: false;

    in-out property <string> dir-text: "";
    in-out property <string> port-text: "5740";
    in-out property <string> ip-text: "192.168.1.5";
    in-out property <int> mode-index: 0;
    in-out property <bool> autostart: false;

    in-out property <string> message: "";
    in-out property <string> log-text: "";
    in-out property <int> log-count: 0;
    in-out property <string> config-path: "";

    callback browse-clicked();
    callback start-clicked();
    callback stop-clicked();
    callback autostart-toggled(bool);
    callback open-dir();
    callback open-log();
    callback clear-log();

    // 状态色只用于小圆点/图标，不做大面积填充
    private property <color> status-color: root.status-kind == 2 ? #0F7B0F : root.status-kind == 3 ? #9D5D00 : #8A8A8A;
    private property <string> status-glyph: root.status-kind == 2 ? "✓" : root.status-kind == 3 ? "!" : "•";
    private property <string> status-text: root.status-kind == 2 ? "已连接" : root.status-kind == 3 ? "重试中" : root.status-kind == 1 ? "等待中" : "未启动";

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // ---------------- 顶部 ----------------
        HorizontalLayout {
            height: 48px;
            spacing: 12px;

            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: 11px;
                background: #FFFFFF;
                border-width: 1px;
                border-color: #E5E5E5;
                Image {
                    source: @image-url("logo-brand.png");
                    width: 30px;
                    height: 30px;
                    x: 6px;
                    y: 6px;
                }
            }

            VerticalLayout {
                alignment: start;
                spacing: 2px;
                Text { text: "多轨快传"; font-size: 20px; font-weight: 700; color: #1A1A1A; }
                Text { text: "电脑接收器  ·  v" + root.app-version; font-size: 11px; color: #616161; }
            }

            Rectangle { horizontal-stretch: 1; }

            Button { text: "接收文件夹"; clicked => { root.open-dir(); } }
            Button { text: "打开日志"; clicked => { root.open-log(); } }
        }

        // ---------------- 状态卡 ----------------
        Card {
            vertical-stretch: 0;
            HorizontalLayout {
                padding: 22px;
                spacing: 18px;

                Rectangle {
                    width: 56px;
                    height: 56px;
                    border-radius: 28px;
                    background: #F3F3F3;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.status-glyph;
                        color: root.status-color;
                        font-size: 26px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    Text { text: root.status-title; font-size: 23px; font-weight: 600; color: #1A1A1A; }
                    Text { text: root.status-sub; font-size: 12.5px; color: #616161; overflow: elide; }
                }

                Rectangle { horizontal-stretch: 1; }

                // 右侧状态文字：整段用状态色，不再做彩色胶囊
                Text {
                    text: root.status-text;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: root.status-color;
                    vertical-alignment: center;
                }
            }
        }

        // ---------------- 设置卡 ----------------
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 18px;
                spacing: 6px;

                Text { text: "接收设置"; font-size: 15px; font-weight: 600; color: #1A1A1A; }
                Text { text: "电脑端监听参数，改完点「开始接收」生效"; font-size: 11.5px; color: #616161; }
                Rectangle { height: 4px; }

                Divider { }

                HorizontalLayout {
                    height: 46px;
                    vertical-stretch: 0;
                    spacing: 10px;
                    Text { text: "接收文件夹"; width: 96px; vertical-alignment: center; color: #1A1A1A; font-size: 13px; }
                    Rectangle { horizontal-stretch: 1; }
                    LineEdit {
                        width: 340px;
                        text <=> root.dir-text;
                        placeholder-text: "D:\\接收文件夹";
                    }
                    Button { text: "浏览…"; clicked => { root.browse-clicked(); } }
                }

                Divider { }

                HorizontalLayout {
                    height: 46px;
                    vertical-stretch: 0;
                    spacing: 10px;
                    Text { text: "端口"; width: 96px; vertical-alignment: center; color: #1A1A1A; font-size: 13px; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "默认 5740，需与手机端一致"; vertical-alignment: center; font-size: 10.5px; color: #8A8A8A; }
                    LineEdit { width: 120px; text <=> root.port-text; }
                }

                Divider { }

                HorizontalLayout {
                    height: 46px;
                    vertical-stretch: 0;
                    spacing: 10px;
                    Text { text: "连接方式"; width: 96px; vertical-alignment: center; color: #1A1A1A; font-size: 13px; }
                    Rectangle { horizontal-stretch: 1; }
                    LineEdit {
                        width: 180px;
                        text <=> root.ip-text;
                        visible: root.mode-index == 1;
                        placeholder-text: "192.168.1.5";
                    }
                    ComboBox {
                        width: 300px;
                        model: ["自动发现（USB / 局域网）", "指定 IP"];
                        current-index <=> root.mode-index;
                    }
                }

                Divider { }

                HorizontalLayout {
                    height: 46px;
                    vertical-stretch: 0;
                    spacing: 10px;
                    Text { text: "开机自动启动"; width: 96px; vertical-alignment: center; color: #1A1A1A; font-size: 13px; }
                    Text { text: "登录后最小化运行"; vertical-alignment: center; font-size: 10.5px; color: #8A8A8A; }
                    Rectangle { horizontal-stretch: 1; }
                    CheckBox {
                        text: "";
                        checked <=> root.autostart;
                        toggled => { root.autostart-toggled(root.autostart); }
                    }
                }

                Divider { }

                Text {
                    text: root.message;
                    visible: root.message != "";
                    font-size: 11.5px;
                    color: #9D5D00;
                }

                Rectangle { height: 8px; }

                HorizontalLayout {
                    height: 36px;
                    vertical-stretch: 0;
                    spacing: 10px;
                    Text {
                        text: root.config-path;
                        font-size: 10px;
                        color: #8A8A8A;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    SecondaryButton {
                        label: "停止接收";
                        visible: root.running;
                        clicked => { root.stop-clicked(); }
                    }
                    PrimaryButton {
                        label: "开始接收";
                        enabled: !root.running;
                        clicked => { root.start-clicked(); }
                    }
                }
            }
        }

        // ---------------- 日志卡 ----------------
        Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    height: 24px;
                    spacing: 8px;
                    Text { text: "运行日志"; font-size: 14px; font-weight: 600; color: #1A1A1A; vertical-alignment: center; }
                    Text { text: root.log-count + " 行"; font-size: 10px; color: #8A8A8A; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "清空"; clicked => { root.clear-log(); } }
                }

                Rectangle {
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #EDEDED;
                    background: #FAFAFA;
                    vertical-stretch: 1;

                    TextEdit {
                        text: root.log-text;
                        read-only: true;
                        vertical-stretch: 1;
                        font-size: 11px;
                        font-family: "Cascadia Mono, Consolas, Microsoft YaHei UI";
                        placeholder-text: "还没有日志，点「开始接收」试试";
                    }
                }
            }
        }
    }
}
